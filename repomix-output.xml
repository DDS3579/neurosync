                <Volume2 className="size-4 text-cyan" aria-hidden />
              ) : (
                <VolumeX className="size-4 text-muted-foreground" aria-hidden />
              )}
              <Label htmlFor="mind-chime-switch" className="text-caption text-muted-foreground">
                Soft chime
              </Label>
              <Switch
                id="mind-chime-switch"
                checked={chimeEnabled}
                onCheckedChange={setChimeEnabled}
              />
            </div>
          </div>

          {/* Visual Guide Stage */}
          <div className="flex flex-col items-center justify-center gap-4 rounded-card border border-border bg-surface-2/60 px-4 py-7">
            <div className="relative flex size-44 items-center justify-center">
              <svg
                viewBox="0 0 176 176"
                className="size-full -rotate-90"
                aria-hidden="true"
              >
                <circle
                  cx="88"
                  cy="88"
                  r={ringRadius}
                  fill="none"
                  stroke="rgba(255,255,255,0.08)"
                  strokeWidth="4"
                />
                <circle
                  cx="88"
                  cy="88"
                  r={ringRadius}
                  fill="none"
                  stroke={mode === "breathing" ? "#22D3EE" : "#8B5CF6"}
                  strokeWidth="4"
                  strokeLinecap="round"
                  strokeDasharray={ringCircumference}
                  strokeDashoffset={ringOffset}
                />
              </svg>

              {mode === "breathing" ? (
                <div
                  aria-hidden="true"
                  className={cn(
                    "absolute size-32 rounded-full border border-cyan/35 bg-cyan/10",
                    reducedMotion ? "transition-none" : "transition-transform duration-75 ease-linear",
                  )}
                  style={{
                    transform: reducedMotion
                      ? "scale(1)"
                      : `scale(${run.status === "idle" ? 0.72 : phase.scale.toFixed(3)})`,
                  }}
                />
              ) : null}

              <div
                aria-live="off"
                className="relative z-10 flex flex-col items-center text-center"
              >
                {mode === "breathing" ? (
                  <>
                    <span className="text-section font-medium text-foreground">
                      {run.status === "idle" ? "Ready" : phase.label}
                    </span>
                    <span className="mt-0.5 font-mono text-2xl font-medium text-cyan tabular-nums">
                      {run.status === "idle"
                        ? formatMindClock(totalMs)
                        : `${phase.phaseRemainingSec}s`}
                    </span>
                    <span className="mt-1 font-mono text-[11px] text-muted-foreground tabular-nums">
                      {run.status === "idle"
                        ? `${BREATHING_PATTERNS[pattern].cadenceLabel}`
                        : `${formatMindClock(remainingMs)} left · Cycle ${phase.cycleNumber}`}
                    </span>
                  </>
                ) : (
                  <>
                    <span className="text-caption tracking-wide text-muted-foreground uppercase">
                      {run.status === "idle"
                        ? "Ready"
                        : run.status === "paused"
                          ? "Paused"
                          : "Quiet timer"}
                    </span>
                    <span className="mt-1 font-mono text-3xl font-medium text-foreground tabular-nums">
                      {formatMindClock(remainingMs)}
                    </span>
                    <span className="mt-1 font-mono text-[11px] text-muted-foreground tabular-nums">
                      {meditationMin} min session
                    </span>
                  </>
                )}
              </div>
            </div>

            {/* Announces phase/status changes politely without announcing every second tick */}
            <div aria-live="polite" aria-atomic="true" className="sr-only">
              {run.status === "paused"
                ? "Session paused."
                : run.status === "running" && mode === "breathing"
                  ? `${phase.label} for ${phase.phaseDurationSec} seconds.`
                  : run.status === "running"
                    ? `${meditationMin} minute meditation timer running.`
                    : ""}
            </div>

            {mode === "breathing" && run.status !== "idle" ? (
              <div className="w-full max-w-xs space-y-1">
                <div className="h-1.5 w-full overflow-hidden rounded-full bg-surface">
                  <div
                    className="h-full bg-cyan"
                    style={{ width: `${Math.round(phase.phaseProgress * 100)}%` }}
                  />
                </div>
                <p className="text-center font-mono text-[11px] text-muted-foreground tabular-nums">
                  {phase.label} ({phase.phaseDurationSec}s)
                </p>
              </div>
            ) : null}

            <div className="flex flex-wrap items-center justify-center gap-2">
              {run.status === "running" ? (
                <Button
                  type="button"
                  variant="outline"
                  onClick={pauseTimer}
                  className="gap-1.5 rounded-control"
                >
                  <Pause className="size-4" aria-hidden />
                  Pause
                </Button>
              ) : (
                <Button
                  type="button"
                  disabled={saving}
                  onClick={startOrResume}
                  className="gap-1.5 rounded-control bg-violet text-white hover:bg-violet/90"
                >
                  <Play className="size-4" aria-hidden />
                  {run.status === "paused" ? "Resume" : "Start"}
                </Button>
              )}

              {run.status !== "idle" ? (
                <>
                  <Button
                    type="button"
                    variant="outline"
                    onClick={resetTimer}
                    className="gap-1.5 rounded-control"
                  >
                    <RotateCcw className="size-4" aria-hidden />
                    Reset
                  </Button>
                  {elapsedMs >= 30_000 ? (
                    <Button
                      type="button"
                      variant="secondary"
                      disabled={saving}
                      onClick={() => void finishEarlyAndSave()}
                      className="rounded-control"
                    >
                      Finish &amp; log
                    </Button>
                  ) : null}
                </>
              ) : null}
            </div>
          </div>
        </div>
      </Card>

      {/* Past mindfulness sessions */}
      <div className="space-y-3 lg:col-span-5">
        <h2 className="text-section font-medium text-foreground">Past mindfulness sessions</h2>
        {sortedSessions.length === 0 ? (
          <EmptyState
            title="No mindfulness sessions yet"
            description="Completed breathing and meditation sessions appear here and feed Brain Explorer."
          />
        ) : (
          <ul className="space-y-2.5">
            {sortedSessions.slice(0, 10).map((session) => (
              <li
                key={session.id}
                className="flex items-center justify-between gap-3 rounded-card border border-border bg-surface p-4"
              >
                <div className="space-y-1">
                  <div className="flex items-center gap-2">
                    <span className="font-mono text-caption text-cyan tabular-nums">
                      {session.date}
                    </span>
                    <span className="text-body font-medium text-foreground">
                      {MINDFULNESS_TYPE_LABELS[session.type]}
                    </span>
                  </div>
                  <p className="font-mono text-caption text-muted-foreground tabular-nums">
                    {session.durationMin} min
                  </p>
                </div>

                <Button
                  type="button"
                  size="icon-sm"
                  variant="ghost"
                  aria-label={`Delete ${MINDFULNESS_TYPE_LABELS[session.type]} session on ${session.date}`}
                  onClick={async () => {
                    await onDeleteSession(session.id);
                    toast.success(`Removed mindfulness session for ${session.date}.`);
                  }}
                >
                  <Trash2 className="size-3.5 text-muted-foreground" aria-hidden />
                </Button>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  );
}
</file>

<file path="src/features/overview/overview-charts.tsx">
"use client";

import { memo } from "react";
import {
  Area,
  AreaChart,
  Bar,
  BarChart,
  CartesianGrid,
  Line,
  LineChart,
  ReferenceLine,
  XAxis,
  YAxis,
} from "recharts";

import {
  ChartContainer,
  ChartLegend,
  ChartLegendContent,
  ChartTooltip,
  ChartTooltipContent,
  type ChartConfig,
} from "@/components/ui/chart";

export interface SleepChartPoint {
  day: string;
  hours: number | null;
}

export interface FocusChartPoint {
  day: string;
  minutes: number;
}

export interface MoodChartPoint {
  day: string;
  mood: number | null;
  concentration: number | null;
}

const axisTick = { fontSize: 11, fill: "var(--color-muted-foreground)" } as const;

const sleepConfig = {
  hours: { label: "Sleep (hours)", color: "var(--chart-2)" },
} satisfies ChartConfig;

const focusConfig = {
  minutes: { label: "Focus (minutes)", color: "var(--chart-1)" },
} satisfies ChartConfig;

const moodConfig = {
  mood: { label: "Mood", color: "var(--chart-1)" },
  concentration: { label: "Concentration", color: "var(--chart-2)" },
} satisfies ChartConfig;

export const SleepChart = memo(function SleepChart({
  data,
  targetHours,
}: {
  data: SleepChartPoint[];
  targetHours: number;
}) {
  const upperBound = Math.max(Math.ceil(targetHours) + 1, 9);

  return (
    <ChartContainer config={sleepConfig} className="aspect-auto h-[168px] w-full">
      <BarChart data={data} margin={{ top: 12, right: 8, bottom: 0, left: -18 }}>
        <CartesianGrid vertical={false} stroke="var(--color-border)" />
        <XAxis
          dataKey="day"
          tickLine={false}
          axisLine={false}
          tickMargin={8}
          tick={axisTick}
        />
        <YAxis
          tickLine={false}
          axisLine={false}
          width={34}
          domain={[0, upperBound]}
          tickCount={4}
          tick={axisTick}
        />
        <ChartTooltip cursor={false} content={<ChartTooltipContent />} />
        <ReferenceLine
          y={targetHours}
          stroke="var(--color-muted-foreground)"
          strokeDasharray="4 4"
          label={{
            value: "Your target",
            position: "insideTopRight",
            fontSize: 10,
            fill: "var(--color-muted-foreground)",
          }}
        />
        <Bar
          dataKey="hours"
          name="Sleep"
          fill="var(--color-hours)"
          radius={[4, 4, 0, 0]}
          maxBarSize={26}
        />
      </BarChart>
    </ChartContainer>
  );
});

export const FocusChart = memo(function FocusChart({ data }: { data: FocusChartPoint[] }) {
  return (
    <ChartContainer config={focusConfig} className="aspect-auto h-[168px] w-full">
      <AreaChart data={data} margin={{ top: 12, right: 8, bottom: 0, left: -18 }}>
        <CartesianGrid vertical={false} stroke="var(--color-border)" />
        <XAxis
          dataKey="day"
          tickLine={false}
          axisLine={false}
          tickMargin={8}
          tick={axisTick}
        />
        <YAxis tickLine={false} axisLine={false} width={34} tickCount={4} tick={axisTick} />
        <ChartTooltip cursor={false} content={<ChartTooltipContent />} />
        <Area
          type="monotone"
          dataKey="minutes"
          name="Focus"
          stroke="var(--color-minutes)"
          strokeWidth={2}
          fill="var(--color-minutes)"
          fillOpacity={0.16}
          connectNulls={false}
          dot={false}
        />
      </AreaChart>
    </ChartContainer>
  );
});

export const MoodChart = memo(function MoodChart({ data }: { data: MoodChartPoint[] }) {
  return (
    <ChartContainer config={moodConfig} className="aspect-auto h-[168px] w-full">
      <LineChart data={data} margin={{ top: 12, right: 8, bottom: 0, left: -24 }}>
        <CartesianGrid vertical={false} stroke="var(--color-border)" />
        <XAxis
          dataKey="day"
          tickLine={false}
          axisLine={false}
          tickMargin={8}
          tick={axisTick}
        />
        <YAxis
          tickLine={false}
          axisLine={false}
          width={28}
          domain={[1, 5]}
          ticks={[1, 2, 3, 4, 5]}
          allowDecimals={false}
          tick={axisTick}
        />
        <ChartTooltip cursor={false} content={<ChartTooltipContent />} />
        <ChartLegend content={<ChartLegendContent />} />
        <Line
          type="monotone"
          dataKey="mood"
          name="Mood (solid)"
          stroke="var(--color-mood)"
          strokeWidth={2.25}
          dot={{ r: 2.5, fill: "var(--color-mood)" }}
          connectNulls={false}
        />
        <Line
          type="monotone"
          dataKey="concentration"
          name="Concentration (dashed)"
          stroke="var(--color-concentration)"
          strokeWidth={2.25}
          strokeDasharray="4 3"
          dot={{ r: 2.5, fill: "var(--color-background)", strokeWidth: 2 }}
          connectNulls={false}
        />
      </LineChart>
    </ChartContainer>
  );
});
