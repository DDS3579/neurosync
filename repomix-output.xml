    expect(movementDays / 60).toBeLessThanOrEqual(0.72);
    expect(d60.nutrition.length / 60).toBeGreaterThanOrEqual(0.55);
    expect(d60.nutrition.length / 60).toBeLessThanOrEqual(0.85);
