<file path="src/features/constellation/constellation.ts">
import { format, startOfDay, subDays } from "date-fns";

import { PERSONAL_ACTIVITY_LABELS } from "@/features/activities/activityUtils";
import type {
  ActivityLog,
  FocusSession,
  Habit,
  HabitLog,
  ISODate,
  LearningMethod,
  MindfulnessSession,
  MindfulnessType,
  MovementLog,
} from "@/types/domain";

export type ConstellationWindowDays = 14 | 30 | 90;

export const CONSTELLATION_WINDOW_OPTIONS: readonly ConstellationWindowDays[] = [14, 30, 90];
export const MIN_CONSTELLATION_DAYS = 10;
export const MIN_SHARED_DAYS = 3;

export const CONSTELLATION_CAVEAT =
  "Purely descriptive: lines show how often two entries happened on the same day, not whether one explains another.";

export const CONSTELLATION_VIEWBOX = {
  width: 800,
  height: 540,
  padding: 62,
} as const;

export type ConstellationCategory =
  | "habit"
  | "activity"
  | "method"
  | "movement"
  | "mindfulness";

export const CONSTELLATION_CATEGORY_LABELS: Record<ConstellationCategory, string> = {
  habit: "Habit",
  activity: "Activity",
  method: "Study method",
  movement: "Movement",
  mindfulness: "Mindfulness",
};

const LEARNING_METHOD_LABELS: Record<LearningMethod, string> = {
  active_recall: "Active recall",
  spaced_repetition: "Spaced repetition",
  problem_solving: "Problem solving",
  deep_reading: "Deep reading",
  skill_practice: "Skill practice",
  teaching: "Teaching",
};

const MOVEMENT_TYPE_LABELS: Record<MovementLog["type"], string> = {
  walk: "Walk",
  run: "Run",
  cycle: "Cycle",
  sport: "Sport",
  gym: "Gym",
  stretch: "Stretch",
  other: "Movement (other)",
};

const MINDFULNESS_TYPE_LABELS: Record<MindfulnessType, string> = {
  box_breathing: "Box breathing",
  "4_7_8_breathing": "4-7-8 breathing",
  meditation: "Meditation",
};

const CATEGORY_LOG_HREF: Record<ConstellationCategory, string> = {
  habit: "/habits#habits",
  activity: "/habits#activities",
  method: "/focus",
  movement: "/habits#movement",
  mindfulness: "/habits#mind",
};

export interface ConstellationNode {
  id: string;
  label: string;
  category: ConstellationCategory;
  daysPresent: number;
  dates: ISODate[];
  frequencyRatio: number;
  radius: number;
  brightness: number;
  x: number;
  y: number;
  logHref: string;
}

export interface ConstellationEdge {
  id: string;
  source: string;
  target: string;
  sharedDays: number;
  sharedDates: ISODate[];
  thickness: number;
}

export interface ConstellationNeighbor {
  nodeId: string;
  label: string;
  category: ConstellationCategory;
  sharedDays: number;
  description: string;
}

export interface ConstellationData {
  windowDays: ConstellationWindowDays;
  windowStart: ISODate;
  windowEnd: ISODate;
  datesInWindow: ISODate[];
  activeDaysCount: number;
  minDaysRequired: number;
  meetsMinDays: boolean;
  hasAnyData: boolean;
  nodes: ConstellationNode[];
  edges: ConstellationEdge[];
  summaryText: string;
}

export interface ConstellationInput {
  habits: readonly Habit[];
  habitLogs: readonly HabitLog[];
  activities: readonly ActivityLog[];
  focus: readonly FocusSession[];
  movement: readonly MovementLog[];
  mindfulness: readonly MindfulnessSession[];
  windowDays?: ConstellationWindowDays;
  today?: Date;
}

function hashStringFNV1a(value: string): number {
  let hash = 0x811c9dc5;
  for (let i = 0; i < value.length; i += 1) {
    hash ^= value.charCodeAt(i);
    hash = Math.imul(hash, 0x01000193);
  }
  return hash >>> 0;
}

function createMulberry32(seed: number): () => number {
  let state = seed >>> 0;
  return () => {
    state = (state + 0x6d2b79f5) >>> 0;
    let t = Math.imul(state ^ (state >>> 15), 1 | state);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

export function formatSameDayCount(sharedDays: number): string {
  return sharedDays === 1
    ? "happened on the same day 1 time"
    : `happened on the same day ${sharedDays} times`;
}

export function getCoOccurrencesForNode(
  nodeId: string,
  nodes: readonly ConstellationNode[],
  edges: readonly ConstellationEdge[],
  limit?: number,
): ConstellationNeighbor[] {
  const byId = new Map(nodes.map((n) => [n.id, n]));
  const items: ConstellationNeighbor[] = [];

  for (const edge of edges) {
    if (edge.source !== nodeId && edge.target !== nodeId) continue;
    const otherId = edge.source === nodeId ? edge.target : edge.source;
    const other = byId.get(otherId);
    if (!other) continue;
    items.push({
      nodeId: other.id,
      label: other.label,
      category: other.category,
      sharedDays: edge.sharedDays,
      description: `${other.label}: ${formatSameDayCount(edge.sharedDays)}`,
    });
  }

  items.sort((a, b) => b.sharedDays - a.sharedDays || a.label.localeCompare(b.label));
  return typeof limit === "number" ? items.slice(0, limit) : items;
}

interface RawNodeAccumulator {
  id: string;
  label: string;
  category: ConstellationCategory;
  dates: Set<ISODate>;
}

/**
 * Computes a deterministic, settled 2D star layout seeded solely by node ids
 * and weighted by shared-day edges so the constellation never drifts between renders.
 */
export function computeDeterministicConstellationLayout(
  nodes: readonly Pick<ConstellationNode, "id" | "radius">[],
  edges: readonly Pick<ConstellationEdge, "source" | "target" | "sharedDays">[],
): Map<string, { x: number; y: number }> {
  const positions = new Map<string, { x: number; y: number }>();
  if (nodes.length === 0) return positions;

  const sortedNodes = [...nodes].sort((a, b) => a.id.localeCompare(b.id));
  const { width, height, padding } = CONSTELLATION_VIEWBOX;
  const cx = width / 2;
  const cy = height / 2;

  interface Body {
    id: string;
    radius: number;
    x: number;
    y: number;
    vx: number;
    vy: number;
  }

  const bodies: Body[] = sortedNodes.map((n, index) => {
    const rng = createMulberry32(hashStringFNV1a(n.id));
    const angle = index * 2.399963229728653 + (rng() - 0.5) * 0.45;
    const ring = Math.sqrt((index + 0.5) / sortedNodes.length);
    const rx = (width / 2 - padding - 20) * (0.28 + 0.65 * ring);
    const ry = (height / 2 - padding - 16) * (0.28 + 0.65 * ring);
    return {
      id: n.id,
      radius: n.radius,
      x: cx + Math.cos(angle) * rx,
      y: cy + Math.sin(angle) * ry,
      vx: 0,
      vy: 0,
    };
  });

  const indexById = new Map(bodies.map((b, i) => [b.id, i]));
  const maxShared = edges.reduce((acc, e) => Math.max(acc, e.sharedDays), MIN_SHARED_DAYS);
  const ticks = 160;

  for (let tick = 0; tick < ticks; tick += 1) {
    const cooling = 1 - tick / ticks;
    const alpha = 0.25 + 0.75 * cooling;

    // 1. Pairwise repulsion with node-radius clearance
    for (let i = 0; i < bodies.length; i += 1) {
      const a = bodies[i]!;
      for (let j = i + 1; j < bodies.length; j += 1) {
        const b = bodies[j]!;
        let dx = b.x - a.x;
        let dy = b.y - a.y;
        let distSq = dx * dx + dy * dy;
        if (distSq < 0.01) {
          dx = 0.1 * ((i % 2 === 0 ? 1 : -1) || 1);
          dy = 0.1 * ((j % 2 === 0 ? -1 : 1) || 1);
          distSq = dx * dx + dy * dy;
        }
        const dist = Math.sqrt(distSq);
        const minDesired = a.radius + b.radius + 54;
        const repulse = 2600 / Math.max(distSq, 144);
        const overlapPush = dist < minDesired ? (minDesired - dist) * 0.22 : 0;
        const force = (repulse + overlapPush) * alpha;
        const nx = dx / dist;
        const ny = dy / dist;

        a.vx -= nx * force;
        a.vy -= ny * force;
        b.vx += nx * force;
        b.vy += ny * force;
      }
    }

    // 2. Co-occurrence spring attraction
    for (const edge of edges) {
      const iA = indexById.get(edge.source);
      const iB = indexById.get(edge.target);
      if (iA === undefined || iB === undefined) continue;
      const a = bodies[iA]!;
      const b = bodies[iB]!;
      const dx = b.x - a.x;
      const dy = b.y - a.y;
      const dist = Math.max(1, Math.hypot(dx, dy));
      const strength = edge.sharedDays / maxShared;
      const targetLen = 195 - strength * 80;
      const pull = (dist - targetLen) * (0.045 + strength * 0.035) * alpha;
      const nx = dx / dist;
      const ny = dy / dist;

      a.vx += nx * pull;
      a.vy += ny * pull;
      b.vx -= nx * pull;
      b.vy -= ny * pull;
    }

    // 3. Gentle centering toward landscape starfield aspect & damping
    for (const body of bodies) {
      body.vx += (cx - body.x) * 0.014 * alpha;
      body.vy += (cy - body.y) * 0.02 * alpha;
      body.vx *= 0.72;
      body.vy *= 0.72;

      body.x = Math.min(width - padding, Math.max(padding, body.x + body.vx));
      body.y = Math.min(height - padding, Math.max(padding, body.y + body.vy));
    }
  }

  for (const body of bodies) {
    positions.set(body.id, {
      x: Math.round(body.x * 100) / 100,
      y: Math.round(body.y * 100) / 100,
    });
  }
  return positions;
}

export function deriveConstellation(input: ConstellationInput): ConstellationData {
  const windowDays: ConstellationWindowDays = input.windowDays ?? 30;
  const end = startOfDay(input.today ?? new Date());
  const datesInWindow: ISODate[] = [];
  for (let offset = windowDays - 1; offset >= 0; offset -= 1) {
    datesInWindow.push(format(subDays(end, offset), "yyyy-MM-dd"));
  }
  const windowStart = datesInWindow[0] ?? format(end, "yyyy-MM-dd");
  const windowEnd = datesInWindow[datesInWindow.length - 1] ?? format(end, "yyyy-MM-dd");
  const inWindow = new Set(datesInWindow);

  const activeHabits = new Map<string, Habit>();
  for (const h of input.habits) {
    if (!h.archived) activeHabits.set(h.id, h);
  }

  const hasAnyData =
    input.habitLogs.some((l) => l.done && activeHabits.has(l.habitId)) ||
    input.activities.length > 0 ||
    input.focus.length > 0 ||
    input.movement.length > 0 ||
    input.mindfulness.length > 0;

  const accumulators = new Map<string, RawNodeAccumulator>();
  const activeDates = new Set<ISODate>();

  const recordOccurrence = (
    id: string,
    label: string,
    category: ConstellationCategory,
    date: ISODate,
  ) => {
    if (!inWindow.has(date)) return;
    activeDates.add(date);
    let acc = accumulators.get(id);
    if (!acc) {
      acc = { id, label, category, dates: new Set<ISODate>() };
      accumulators.set(id, acc);
    }
    acc.dates.add(date);
  };

  for (const log of input.habitLogs) {
    if (!log.done) continue;
    const habit = activeHabits.get(log.habitId);
    if (!habit) continue;
    recordOccurrence(`habit:${habit.id}`, habit.name, "habit", log.date);
  }

  for (const row of input.activities) {
    recordOccurrence(
      `activity:${row.type}`,
      PERSONAL_ACTIVITY_LABELS[row.type],
      "activity",
      row.date,
    );
  }

  for (const row of input.focus) {
    recordOccurrence(
      `method:${row.method}`,
      LEARNING_METHOD_LABELS[row.method],
      "method",
      row.date,
    );
  }

  for (const row of input.movement) {
    recordOccurrence(
      `movement:${row.type}`,
      MOVEMENT_TYPE_LABELS[row.type],
      "movement",
      row.date,
    );
  }

  for (const row of input.mindfulness) {
    recordOccurrence(
      `mindfulness:${row.type}`,
      MINDFULNESS_TYPE_LABELS[row.type],
      "mindfulness",
      row.date,
    );
  }

  const activeDaysCount = activeDates.size;
  const meetsMinDays = activeDaysCount >= MIN_CONSTELLATION_DAYS;

  if (!meetsMinDays) {
    return {
      windowDays,
      windowStart,
      windowEnd,
      datesInWindow,
      activeDaysCount,
      minDaysRequired: MIN_CONSTELLATION_DAYS,
      meetsMinDays: false,
      hasAnyData,
      nodes: [],
      edges: [],
      summaryText: `Constellation needs at least ${MIN_CONSTELLATION_DAYS} logged days in the ${windowDays}-day window (${activeDaysCount} logged so far).`,
    };
  }

  const rawList = Array.from(accumulators.values()).sort((a, b) => a.id.localeCompare(b.id));
  const maxDaysPresent = rawList.reduce((acc, item) => Math.max(acc, item.dates.size), 1);

  const preliminaryNodes = rawList.map((item) => {
    const daysPresent = item.dates.size;
    const frequencyRatio = daysPresent / maxDaysPresent;
    const radius = Math.round((6.5 + frequencyRatio * 8.5) * 10) / 10;
    const brightness = Math.round((0.48 + frequencyRatio * 0.52) * 100) / 100;
    return {
      item,
      daysPresent,
      frequencyRatio,
      radius,
      brightness,
    };
  });

  const rawEdges: Array<{
    id: string;
    source: string;
    target: string;
    sharedDates: ISODate[];
  }> = [];

  for (let i = 0; i < rawList.length; i += 1) {
    const a = rawList[i]!;
    for (let j = i + 1; j < rawList.length; j += 1) {
      const b = rawList[j]!;
      const sharedDates: ISODate[] = [];
      for (const date of a.dates) {
        if (b.dates.has(date)) sharedDates.push(date);
      }
      if (sharedDates.length >= MIN_SHARED_DAYS) {
        sharedDates.sort();
        rawEdges.push({
          id: `${a.id}--${b.id}`,
          source: a.id,
          target: b.id,
          sharedDates,
        });
      }
    }
  }

  const maxSharedDays = rawEdges.reduce(
    (acc, edge) => Math.max(acc, edge.sharedDates.length),
    MIN_SHARED_DAYS,
  );

  const edges: ConstellationEdge[] = rawEdges
    .map((edge) => {
      const ratio = edge.sharedDates.length / maxSharedDays;
      const thickness = Math.round((1.25 + ratio * 3.25) * 100) / 100;
      return {
        id: edge.id,
        source: edge.source,
        target: edge.target,
        sharedDays: edge.sharedDates.length,
        sharedDates: edge.sharedDates,
        thickness,
      };
    })
    .sort((a, b) => b.sharedDays - a.sharedDays || a.id.localeCompare(b.id));

  const positions = computeDeterministicConstellationLayout(
    preliminaryNodes.map((n) => ({ id: n.item.id, radius: n.radius })),
    edges,
  );

  const nodes: ConstellationNode[] = preliminaryNodes
    .map(({ item, daysPresent, frequencyRatio, radius, brightness }) => {
      const pos = positions.get(item.id) ?? {
        x: CONSTELLATION_VIEWBOX.width / 2,
        y: CONSTELLATION_VIEWBOX.height / 2,
      };
      return {
        id: item.id,
        label: item.label,
        category: item.category,
        daysPresent,
        dates: Array.from(item.dates).sort(),
        frequencyRatio,
        radius,
        brightness,
        x: pos.x,
        y: pos.y,
        logHref: CATEGORY_LOG_HREF[item.category],
      };
    })
    .sort((a, b) => b.daysPresent - a.daysPresent || a.label.localeCompare(b.label));

  const summaryText = `Constellation across the last ${windowDays} days (${windowStart} to ${windowEnd}): ${nodes.length} stars across ${activeDaysCount} active days, with ${edges.length} same-day connections (${MIN_SHARED_DAYS}+ shared days).`;

  return {
    windowDays,
    windowStart,
    windowEnd,
    datesInWindow,
    activeDaysCount,
    minDaysRequired: MIN_CONSTELLATION_DAYS,
    meetsMinDays: true,
    hasAnyData,
    nodes,
    edges,
    summaryText,
  };
}
</file>

<file path="src/features/experiments/components/ExperimentsWorkspace.tsx">
"use client";

import { useMemo, useState } from "react";
import { zodResolver } from "@hookform/resolvers/zod";
import { addDays, format, startOfDay } from "date-fns";
import { FlaskConical, Info, Pencil, Plus, Trash2 } from "lucide-react";
import { Controller, useForm } from "react-hook-form";
import { toast } from "sonner";

import { EmptyState, PageHeader } from "@/components/nx";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogFooter,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Skeleton } from "@/components/ui/skeleton";
import { Textarea } from "@/components/ui/textarea";
import {
  deriveExperimentStatus,
  EXPERIMENT_METRICS,
  EXPERIMENT_STATUS_LABEL,
  experimentFormSchema,
  type ExperimentFormValues,
} from "@/features/experiments/experimentUtils";
import { analyzeExperiment } from "@/lib/insights";
import type { Experiment, InsightInput, ISODate } from "@/types/domain";

export interface ExperimentsWorkspaceProps {
  experiments: Experiment[];
  insightInput: InsightInput;
  todayISO: ISODate;
  onCreateExperiment: (
    values: Omit<Experiment, "id" | "createdAt" | "updatedAt">,
  ) => Promise<void>;
  onUpdateExperiment: (
    id: string,
    patch: Partial<Omit<Experiment, "id" | "createdAt" | "updatedAt">>,
  ) => Promise<void>;
  onDeleteExperiment: (id: string) => Promise<void>;
}

function formatExperimentMean(metric: Experiment["metric"], mean: number | null): string {
  if (mean === null) return "—";
  if (metric === "reactionTime") return `${Math.round(mean)} ms`;
  if (metric === "memorySpan") return `${mean} items`;
  return `${mean}/5`;
}

function defaultFormValues(): ExperimentFormValues {
  const today = startOfDay(new Date());
  return {
    title: "",
    hypothesis: "",
    changeDescription: "",
    metric: "concentration",
    baselineStart: format(today, "yyyy-MM-dd"),
    baselineEnd: format(addDays(today, 6), "yyyy-MM-dd"),
    interventionStart: format(addDays(today, 7), "yyyy-MM-dd"),
    interventionEnd: format(addDays(today, 13), "yyyy-MM-dd"),
    reflection: "",
  };
}

export function ExperimentsWorkspace({
  experiments,
  insightInput,
  todayISO,
  onCreateExperiment,
  onUpdateExperiment,
  onDeleteExperiment,
}: ExperimentsWorkspaceProps) {
  const [dialogOpen, setDialogOpen] = useState(false);
  const [editing, setEditing] = useState<Experiment | null>(null);
  const [reflectionDrafts, setReflectionDrafts] = useState<Record<string, string>>({});

  const form = useForm<ExperimentFormValues>({
    resolver: zodResolver(experimentFormSchema),
    defaultValues: defaultFormValues(),
  });

  const sortedExperiments = useMemo(
    () => [...experiments].sort((a, b) => b.createdAt.localeCompare(a.createdAt)),
    [experiments],
  );

  const openCreate = () => {
    setEditing(null);
    form.reset(defaultFormValues());
    setDialogOpen(true);
  };

  const openEdit = (exp: Experiment) => {
    setEditing(exp);
    form.reset({
      title: exp.title,
      hypothesis: exp.hypothesis,
      changeDescription: exp.changeDescription,
      metric: exp.metric,
      baselineStart: exp.baselineStart,
      baselineEnd: exp.baselineEnd,
      interventionStart: exp.interventionStart,
      interventionEnd: exp.interventionEnd,
      reflection: exp.reflection ?? "",
    });
    setDialogOpen(true);
  };

  const onSubmit = async (values: ExperimentFormValues) => {
    const parsed = experimentFormSchema.parse(values);
    const derivedStatus = deriveExperimentStatus(parsed, todayISO);
    const payload = {
      title: parsed.title,
      hypothesis: parsed.hypothesis,
      changeDescription: parsed.changeDescription,
      metric: parsed.metric,
      baselineStart: parsed.baselineStart,
      baselineEnd: parsed.baselineEnd,
      interventionStart: parsed.interventionStart,
      interventionEnd: parsed.interventionEnd,
      status: derivedStatus,
      reflection: parsed.reflection?.trim() || undefined,
    };

    if (editing) {
      await onUpdateExperiment(editing.id, payload);
      toast.success(`Updated experiment "${parsed.title}".`);
    } else {
      await onCreateExperiment(payload);
      toast.success(`Created experiment "${parsed.title}".`);
    }
    setDialogOpen(false);
    setEditing(null);
  };

  return (
    <div className="space-y-6">
      <PageHeader
        title="Experiment Lab"
        description="Compare a baseline window against an intervention window on one self-rated metric."
        actions={
          <Button
            type="button"
            onClick={openCreate}
            className="gap-1.5 rounded-control bg-violet text-white hover:bg-violet/90"
          >
            <Plus className="size-4" aria-hidden />
            New experiment
          </Button>
        }
      />

      {sortedExperiments.length === 0 ? (
        <EmptyState
          icon={<FlaskConical />}
          title="No personal experiments yet"
          description="Write a hypothesis, choose a metric and two date windows, and review the comparison once both windows accumulate logs."
          action={
            <Button
              type="button"
              onClick={openCreate}
              className="rounded-control bg-violet text-white hover:bg-violet/90"
            >
              Create your first experiment
            </Button>
          }
        />
      ) : (
        <div className="space-y-5">
          {sortedExperiments.map((exp) => {
            const status = deriveExperimentStatus(exp, todayISO);
            const result = analyzeExperiment({ ...exp, status }, insightInput);
            const metricLabel =
              EXPERIMENT_METRICS.find((m) => m.value === exp.metric)?.label ?? exp.metric;
            const reflectionValue = reflectionDrafts[exp.id] ?? exp.reflection ?? "";

            return (
              <Card
                key={exp.id}
                className="space-y-5 rounded-card border border-border bg-surface p-5 shadow-none sm:p-6"
              >
                <div className="flex flex-wrap items-start justify-between gap-4 border-b border-border pb-4">
                  <div className="space-y-1.5">
                    <div className="flex flex-wrap items-center gap-2">
                      <Badge
                        variant="outline"
                        className="border-cyan/40 bg-cyan/10 font-mono text-[11px] uppercase tracking-[0.12em] text-cyan"
                      >
                        {EXPERIMENT_STATUS_LABEL[status]}
                      </Badge>
                      <span className="font-mono text-caption text-muted-foreground">
                        {metricLabel}
                      </span>
                    </div>
                    <h2 className="text-section font-medium text-foreground">{exp.title}</h2>
                    <p className="text-body text-muted-foreground">{exp.hypothesis}</p>
                    <p className="text-caption text-muted-foreground">
                      Change: {exp.changeDescription}
                    </p>
                  </div>

                  <div className="flex shrink-0 items-center gap-1">
                    <Button
                      type="button"
                      size="icon-sm"
                      variant="ghost"
                      aria-label={`Edit experiment ${exp.title}`}
                      onClick={() => openEdit(exp)}
                    >
                      <Pencil className="size-3.5" aria-hidden />
                    </Button>
                    <Button
                      type="button"
                      size="icon-sm"
                      variant="ghost"
                      aria-label={`Delete experiment ${exp.title}`}
                      onClick={async () => {
                        await onDeleteExperiment(exp.id);
                        toast.success(`Deleted "${exp.title}".`);
                      }}
                    >
                      <Trash2 className="size-3.5 text-muted-foreground" aria-hidden />
                    </Button>
                  </div>
                </div>

                {/* Window comparison */}
                <div className="grid gap-4 md:grid-cols-2">
                  <div className="rounded-control border border-border bg-surface-2 p-4">
                    <div className="flex items-center justify-between gap-2">
                      <span className="font-mono text-caption uppercase tracking-[0.12em] text-muted-foreground">
                        Baseline
                      </span>
                      <span className="font-mono text-caption text-muted-foreground tabular-nums">
                        {exp.baselineStart} → {exp.baselineEnd}
                      </span>
                    </div>
                    <p className="mt-2 font-mono text-title font-medium text-foreground tabular-nums">
                      {formatExperimentMean(exp.metric, result.baseline.mean)}
                    </p>
                    <p className="text-caption text-muted-foreground tabular-nums">
                      Sample size: {result.baseline.n}{" "}
                      {result.baseline.n === 1 ? "day" : "days"}
                    </p>
                  </div>

                  <div className="rounded-control border border-border bg-surface-2 p-4">
                    <div className="flex items-center justify-between gap-2">
                      <span className="font-mono text-caption uppercase tracking-[0.12em] text-cyan">
                        Intervention
                      </span>
                      <span className="font-mono text-caption text-muted-foreground tabular-nums">
                        {exp.interventionStart} → {exp.interventionEnd}
                      </span>
                    </div>
                    <p className="mt-2 font-mono text-title font-medium text-foreground tabular-nums">
                      {formatExperimentMean(exp.metric, result.intervention.mean)}
                    </p>
                    <p className="text-caption text-muted-foreground tabular-nums">
                      Sample size: {result.intervention.n}{" "}
                      {result.intervention.n === 1 ? "day" : "days"}
                    </p>
                  </div>
                </div>

                <div className="space-y-2">
                  <p className="text-body text-foreground">{result.summary}</p>
                  {result.effectSizeNote ? (
                    <p className="text-caption text-muted-foreground">{result.effectSizeNote}</p>
                  ) : null}
                </div>

                {/* Mandatory causation caveat */}
                <div className="flex items-start gap-2 rounded-control border border-border bg-background/60 p-3">
                  <Info className="mt-0.5 size-4 shrink-0 text-cyan" aria-hidden />
                  <div className="space-y-1 text-caption text-muted-foreground">
                    {result.caveats.map((caveat, i) => (
                      <p key={i}>{caveat}</p>
                    ))}
                  </div>
                </div>

                {/* Closing reflection */}
                <div className="space-y-2 border-t border-border pt-4">
                  <Label htmlFor={`reflection-${exp.id}`}>Closing reflection</Label>
                  <div className="flex flex-col gap-2 sm:flex-row">
                    <Textarea
                      id={`reflection-${exp.id}`}
                      rows={2}
                      placeholder="What felt realistic, what else shifted, and would you keep this change?"
                      value={reflectionValue}
                      onChange={(e) =>
                        setReflectionDrafts((prev) => ({
                          ...prev,
                          [exp.id]: e.target.value,
                        }))
                      }
                      className="flex-1 rounded-control border-border bg-surface-2"
                    />
                    <Button
                      type="button"
                      variant="outline"
                      onClick={async () => {
                        await onUpdateExperiment(exp.id, {
                          reflection: reflectionValue.trim() || undefined,
                          status,
                        });
                        toast.success("Saved reflection.");
                      }}
                      className="self-end rounded-control sm:self-start"
                    >
                      Save reflection
                    </Button>
                  </div>
                </div>
              </Card>
            );
          })}
        </div>
      )}

      <Dialog open={dialogOpen} onOpenChange={setDialogOpen}>
        <DialogContent className="max-h-[90svh] overflow-y-auto border-border bg-surface sm:max-w-lg">
          <DialogHeader>
            <DialogTitle>{editing ? "Edit experiment" : "New personal experiment"}</DialogTitle>
            <DialogDescription>
              Status is derived automatically from your baseline and intervention dates.
            </DialogDescription>
          </DialogHeader>

          <form onSubmit={form.handleSubmit(onSubmit)} className="space-y-4" noValidate>
            <div className="space-y-1.5">
              <Label htmlFor="exp-title">Title</Label>
              <Input
                id="exp-title"
                placeholder="e.g. Does a steadier bedtime change how focused I feel?"
                {...form.register("title")}
                className="rounded-control border-border bg-surface-2"
              />
              {form.formState.errors.title ? (
                <p role="alert" className="text-caption text-danger">
                  {form.formState.errors.title.message}
                </p>
              ) : null}
            </div>

            <div className="space-y-1.5">
              <Label htmlFor="exp-hypothesis">Hypothesis</Label>
              <Textarea
                id="exp-hypothesis"
                rows={2}
                placeholder="What do you expect might coincide with this change?"
                {...form.register("hypothesis")}
                className="rounded-control border-border bg-surface-2"
              />
              {form.formState.errors.hypothesis ? (
                <p role="alert" className="text-caption text-danger">
                  {form.formState.errors.hypothesis.message}
                </p>
              ) : null}
            </div>

            <div className="space-y-1.5">
              <Label htmlFor="exp-change">Change description</Label>
              <Input
                id="exp-change"
                placeholder="e.g. Keep bedtime within a 30-minute window"
                {...form.register("changeDescription")}
                className="rounded-control border-border bg-surface-2"
              />
              {form.formState.errors.changeDescription ? (
                <p role="alert" className="text-caption text-danger">
                  {form.formState.errors.changeDescription.message}
                </p>
              ) : null}
            </div>

            <div className="space-y-1.5">
              <Label htmlFor="exp-metric">Tracked metric</Label>
              <Controller
                control={form.control}
                name="metric"
                render={({ field }) => (
                  <Select value={field.value} onValueChange={field.onChange}>
                    <SelectTrigger
                      id="exp-metric"
                      className="w-full rounded-control border-border bg-surface-2"
                    >
                      <SelectValue placeholder="Choose metric" />
                    </SelectTrigger>
                    <SelectContent>
                      {EXPERIMENT_METRICS.map((m) => (
                        <SelectItem key={m.value} value={m.value}>
                          {m.label}
                        </SelectItem>
                      ))}
                    </SelectContent>
                  </Select>
                )}
              />
            </div>

            <div className="grid gap-3 sm:grid-cols-2">
              <div className="space-y-1.5">
                <Label htmlFor="exp-b-start">Baseline start</Label>
                <Input
                  id="exp-b-start"
                  type="date"
                  {...form.register("baselineStart")}
                  className="rounded-control border-border bg-surface-2 font-mono"
                />
                {form.formState.errors.baselineStart ? (
                  <p role="alert" className="text-caption text-danger">
                    {form.formState.errors.baselineStart.message}
                  </p>
                ) : null}
              </div>

              <div className="space-y-1.5">
                <Label htmlFor="exp-b-end">Baseline end</Label>
                <Input
                  id="exp-b-end"
                  type="date"
                  {...form.register("baselineEnd")}
                  className="rounded-control border-border bg-surface-2 font-mono"
                />
                {form.formState.errors.baselineEnd ? (
                  <p role="alert" className="text-caption text-danger">
                    {form.formState.errors.baselineEnd.message}
                  </p>
                ) : null}
              </div>

              <div className="space-y-1.5">
                <Label htmlFor="exp-i-start">Intervention start</Label>
                <Input
                  id="exp-i-start"
                  type="date"
                  {...form.register("interventionStart")}
                  className="rounded-control border-border bg-surface-2 font-mono"
                />
                {form.formState.errors.interventionStart ? (
                  <p role="alert" className="text-caption text-danger">
                    {form.formState.errors.interventionStart.message}
                  </p>
                ) : null}
              </div>

              <div className="space-y-1.5">
                <Label htmlFor="exp-i-end">Intervention end</Label>
                <Input
                  id="exp-i-end"
                  type="date"
                  {...form.register("interventionEnd")}
                  className="rounded-control border-border bg-surface-2 font-mono"
                />
                {form.formState.errors.interventionEnd ? (
                  <p role="alert" className="text-caption text-danger">
                    {form.formState.errors.interventionEnd.message}
                  </p>
                ) : null}
              </div>
            </div>

            <DialogFooter className="gap-2">
              <Button
                type="button"
                variant="outline"
                onClick={() => setDialogOpen(false)}
                className="rounded-control"
              >
                Cancel
              </Button>
              <Button
                type="submit"
                disabled={form.formState.isSubmitting}
                className="rounded-control bg-violet text-white hover:bg-violet/90"
              >
                {editing ? "Save changes" : "Create experiment"}
              </Button>
            </DialogFooter>
          </form>
        </DialogContent>
      </Dialog>
    </div>
  );
}

export function ExperimentsSkeleton() {
  return (
    <div className="space-y-6" aria-hidden>
      <div className="space-y-2">
        <Skeleton className="h-8 w-52 rounded-[6px]" />
        <Skeleton className="h-4 w-96 max-w-full rounded-[4px]" />
      </div>
      <Skeleton className="h-72 rounded-card" />
    </div>
  );
}
