<file path="src/features/focus/reviewScheduler.ts">
import { addDays, format, parseISO } from "date-fns";
import { z } from "zod";

import type { ISODate, ReviewDifficulty, ReviewItem } from "@/types/domain";

export const REVIEW_INTERVAL_DAYS = [1, 3, 7, 14, 30] as const;

export function addDaysISO(dateISO: ISODate, days: number): ISODate {
  return format(addDays(parseISO(dateISO), days), "yyyy-MM-dd");
}

function clampIntervalStep(step: number): number {
  if (!Number.isFinite(step)) return 0;
  return Math.max(0, Math.min(REVIEW_INTERVAL_DAYS.length - 1, Math.trunc(step)));
}

export function intervalDaysForStep(step: number): number {
  return REVIEW_INTERVAL_DAYS[clampIntervalStep(step)] ?? 1;
}

export function createInitialReviewSchedule(todayISO: ISODate): {
  intervalStep: number;
  nextReviewDate: ISODate;
  reviewCount: number;
} {
  return {
    intervalStep: 0,
    nextReviewDate: addDaysISO(todayISO, REVIEW_INTERVAL_DAYS[0]),
    reviewCount: 0,
  };
}

/**
 * Computes the next fixed-interval review step:
 * - "easy": advances one interval (up to 30 days)
 * - "okay": repeats the current interval
 * - "hard": steps back one interval (down to 1 day)
 */
export function scheduleNextReview(
  item: Pick<ReviewItem, "intervalStep" | "reviewCount">,
  rating: ReviewDifficulty,
  todayISO: ISODate,
): {
  intervalStep: number;
  intervalDays: number;
  nextReviewDate: ISODate;
  lastReviewedDate: ISODate;
  reviewCount: number;
} {
  const currentStep = clampIntervalStep(item.intervalStep);
  const nextStep =
    rating === "easy"
      ? clampIntervalStep(currentStep + 1)
      : rating === "hard"
        ? clampIntervalStep(currentStep - 1)
        : currentStep;

  const intervalDays = intervalDaysForStep(nextStep);
  return {
    intervalStep: nextStep,
    intervalDays,
    nextReviewDate: addDaysISO(todayISO, intervalDays),
    lastReviewedDate: todayISO,
    reviewCount: Math.max(0, item.reviewCount) + 1,
  };
}

export function isReviewDue(item: Pick<ReviewItem, "nextReviewDate">, todayISO: ISODate): boolean {
  return item.nextReviewDate <= todayISO;
}

export function partitionReviewQueue(
  items: readonly ReviewItem[],
  todayISO: ISODate,
): { due: ReviewItem[]; upcoming: ReviewItem[] } {
  const due: ReviewItem[] = [];
  const upcoming: ReviewItem[] = [];

  for (const item of items) {
    if (isReviewDue(item, todayISO)) {
      due.push(item);
    } else {
      upcoming.push(item);
    }
  }

  const byDateThenTopic = (a: ReviewItem, b: ReviewItem) => {
    const byDate = a.nextReviewDate.localeCompare(b.nextReviewDate);
    return byDate !== 0 ? byDate : a.topic.localeCompare(b.topic);
  };

  due.sort(byDateThenTopic);
  upcoming.sort(byDateThenTopic);

  return { due, upcoming };
}

export const reviewItemFormSchema = z.object({
  topic: z
    .string()
    .trim()
    .min(1, "Enter a topic to review.")
    .max(120, "Keep the topic under 120 characters."),
  notes: z.string().trim().max(240, "Keep notes under 240 characters.").optional(),
});

export type ReviewItemFormValues = z.input<typeof reviewItemFormSchema>;
</file>

<file path="src/features/focus/timerUtils.test.ts">
import { describe, expect, it } from "vitest";

import {
  computeElapsedMs,
  computePausedMs,
  computeRemainingMs,
  deserializeRunningSession,
  incrementDistractions,
  isSessionPaused,
  parseFocusTabHash,
  pauseRunningSession,
  resumeRunningSession,
  serializeRunningSession,
  startRunningSession,
} from "./timerUtils";

describe("focus timer timestamp math", () => {
  it("computes elapsed and remaining time across multiple pause/resume intervals", () => {
    const t0 = 1_700_000_000_000;
    let session = startRunningSession({
      subject: "Neuroanatomy",
      method: "active_recall",
      plannedMin: 25,
      nowMs: t0,
    });

    // Run 5 minutes, pause for 3 minutes, run 10 minutes
    session = pauseRunningSession(session, t0 + 5 * 60_000);
    expect(isSessionPaused(session)).toBe(true);
    // While paused at +7m, elapsed stays frozen at 5m
    expect(computeElapsedMs(session, t0 + 7 * 60_000)).toBe(5 * 60_000);

    session = resumeRunningSession(session, t0 + 8 * 60_000);
    expect(isSessionPaused(session)).toBe(false);
    expect(computePausedMs(session.pausedIntervals, t0 + 18 * 60_000)).toBe(3 * 60_000);

    // At t0 + 18m (with 3m paused), active elapsed = 15m, remaining = 10m
    expect(computeElapsedMs(session, t0 + 18 * 60_000)).toBe(15 * 60_000);
    expect(computeRemainingMs(session, t0 + 18 * 60_000)).toBe(10 * 60_000);
  });

  it("resumes accurately after serialization and page reload", () => {
    const t0 = 1_700_000_000_000;
    let session = startRunningSession({
      subject: "Systems reading",
      method: "deep_reading",
      plannedMin: 50,
      nowMs: t0,
    });
    session = incrementDistractions(session);
    session = pauseRunningSession(session, t0 + 10 * 60_000);
    session = resumeRunningSession(session, t0 + 12 * 60_000);

    const raw = serializeRunningSession(session);
    const restored = deserializeRunningSession(raw);

    expect(restored).not.toBeNull();
    if (!restored) return;

    // 25 minutes after start with 2 minutes paused => 23m elapsed, 27m remaining
    const afterReloadMs = t0 + 25 * 60_000;
    expect(computeElapsedMs(restored, afterReloadMs)).toBe(23 * 60_000);
    expect(computeRemainingMs(restored, afterReloadMs)).toBe(27 * 60_000);
    expect(restored.distractions).toBe(1);
  });

  it("clamps remaining time at 0 when elapsed exceeds planned duration", () => {
    const t0 = 1_700_000_000_000;
    const session = startRunningSession({
      subject: "Practice",
      method: "problem_solving",
      plannedMin: 25,
      nowMs: t0,
    });

    expect(computeRemainingMs(session, t0 + 30 * 60_000)).toBe(0);
    expect(computeElapsedMs(session, t0 + 30 * 60_000)).toBe(30 * 60_000);
  });

  it("parses Focus Lab tab hashes safely", () => {
    expect(parseFocusTabHash("#review")).toBe("review");
    expect(parseFocusTabHash("#METHODS")).toBe("methods");
    expect(parseFocusTabHash("#timer")).toBe("timer");
    expect(parseFocusTabHash("")).toBe("timer");
    expect(parseFocusTabHash("#unknown")).toBe("timer");
  });
});
</file>

