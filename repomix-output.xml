"use client";

import { useEffect, useState } from "react";
import { ChevronLeft, ChevronRight, Pause, Play } from "lucide-react";

import { Button } from "@/components/ui/button";
import { Slider } from "@/components/ui/slider";
import { ToggleGroup, ToggleGroupItem } from "@/components/ui/toggle-group";
import type { BrainTimelineData } from "@/features/brain/brainActivity";
import { cn } from "@/lib/utils";

export interface BrainTimeScrubberProps {
  timeline: BrainTimelineData;
  windowDays: 7 | 30;
  onChangeWindowDays: (days: 7 | 30) => void;
  dayIndex: number;
  cumulative: boolean;
  onChangeCumulative: (cumulative: boolean) => void;
  onSelectDay: (index: number) => void;
  reducedMotion: boolean;
}

export function BrainTimeScrubber({
  timeline,
  windowDays,
  onChangeWindowDays,
  dayIndex,
  cumulative,
  onChangeCumulative,
  onSelectDay,
  reducedMotion,
}: BrainTimeScrubberProps) {
  const [playing, setPlaying] = useState(false);

  const maxIndex = Math.max(0, timeline.days.length - 1);
  const clampedIdx = Math.min(maxIndex, Math.max(0, dayIndex));
  const activeDay = timeline.days[clampedIdx];
  const snapshot = activeDay
    ? cumulative
      ? activeDay.cumulative
      : activeDay.dayOnly
    : null;

  const isPlaying = playing && !reducedMotion && maxIndex > 0;

  useEffect(() => {
    if (!isPlaying) return;
    const id = window.setInterval(() => {
      if (clampedIdx >= maxIndex) {
        setPlaying(false);
        return;
      }
      onSelectDay(clampedIdx + 1);
    }, 700);
    return () => window.clearInterval(id);
  }, [isPlaying, clampedIdx, maxIndex, onSelectDay]);

  const handleTogglePlay = () => {
    if (reducedMotion || maxIndex === 0) return;
    if (playing) {
      setPlaying(false);
      return;
    }
    if (clampedIdx >= maxIndex) {
      onSelectDay(0);
    }
    setPlaying(true);
  };

  return (
    <div className="space-y-2.5">
      <div className="flex flex-wrap items-center justify-between gap-2">
        <div className="flex items-center gap-1.5">
          <Button
            type="button"
            size="sm"
            variant="outline"
            aria-label="Previous day"
            disabled={clampedIdx <= 0}
            onClick={() => {
              setPlaying(false);
              onSelectDay(Math.max(0, clampedIdx - 1));
            }}
            className="size-7 rounded-chip p-0"
          >
            <ChevronLeft className="size-3.5" aria-hidden />
          </Button>

          <Button
            type="button"
            size="sm"
            variant={isPlaying ? "default" : "outline"}
            disabled={reducedMotion || maxIndex === 0}
            aria-label={
              reducedMotion
                ? "Playback disabled while reduced motion is enabled"
                : isPlaying
                  ? "Pause day playback"
                  : "Play through days"
            }
            title={
              reducedMotion
                ? "Reduced motion enabled — use step buttons"
                : isPlaying
                  ? "Pause"
                  : "Play timeline"
            }
            onClick={handleTogglePlay}
            className={cn(
              "h-7 gap-1 rounded-chip px-2 text-caption",
              isPlaying && "bg-cyan text-[#060913] hover:bg-cyan/90",
            )}
          >
            {isPlaying ? (
              <Pause className="size-3" aria-hidden />
            ) : (
              <Play className="size-3" aria-hidden />
            )}
            <span className="sr-only sm:not-sr-only">
              {isPlaying ? "Pause" : "Play"}
            </span>
          </Button>

          <Button
            type="button"
            size="sm"
            variant="outline"
            aria-label="Next day"
            disabled={clampedIdx >= maxIndex}
            onClick={() => {
              setPlaying(false);
              onSelectDay(Math.min(maxIndex, clampedIdx + 1));
            }}
            className="size-7 rounded-chip p-0"
          >
            <ChevronRight className="size-3.5" aria-hidden />
          </Button>

          <span className="ml-1 font-mono text-caption text-foreground tabular-nums">
            {activeDay ? activeDay.shortLabel : "—"}
          </span>
          {snapshot ? (
            <span className="font-mono text-[11px] text-muted-foreground tabular-nums">
              · {snapshot.totalMinutes}m
            </span>
          ) : null}
        </div>

        <div className="flex flex-wrap items-center gap-1.5">
          <ToggleGroup
            type="single"
            value={cumulative ? "cumulative" : "day"}
            onValueChange={(v) => {
              if (!v) return;
              onChangeCumulative(v === "cumulative");
            }}
            variant="outline"
            size="sm"
            aria-label="Timeline accumulation mode"
          >
            <ToggleGroupItem value="day" className="h-7 px-2 text-[11px]">
              That day
            </ToggleGroupItem>
            <ToggleGroupItem value="cumulative" className="h-7 px-2 text-[11px]">
              Cumulative
            </ToggleGroupItem>
          </ToggleGroup>

          <ToggleGroup
            type="single"
            value={String(windowDays)}
            onValueChange={(v) => {
              if (v === "7" || v === "30") {
                setPlaying(false);
                onChangeWindowDays(v === "30" ? 30 : 7);
              }
            }}
            variant="outline"
            size="sm"
            aria-label="Timeline window length"
          >
            <ToggleGroupItem value="7" className="h-7 px-2 font-mono text-[11px]">
              7d
            </ToggleGroupItem>
            <ToggleGroupItem value="30" className="h-7 px-2 font-mono text-[11px]">
              30d
            </ToggleGroupItem>
          </ToggleGroup>
        </div>
      </div>

      <div className="space-y-1">
        <Slider
          aria-label="Timeline day"
          min={0}
          max={maxIndex}
          step={1}
          value={[clampedIdx]}
          onValueChange={(vals) => {
            const next = vals[0];
            if (typeof next !== "number") return;
            setPlaying(false);
            onSelectDay(next);
          }}
        />

        {windowDays === 7 ? (
          <div className="grid grid-cols-7 gap-0.5 pt-0.5">
            {timeline.days.map((d, idx) => {
              const selected = idx === clampedIdx;
              const hasLogs = d.dayOnly.totalMinutes > 0;
              return (
                <button
                  key={d.date}
                  type="button"
                  onClick={() => {
                    setPlaying(false);
                    onSelectDay(idx);
                  }}
                  aria-label={`Select ${d.shortLabel} (${d.dayOnly.totalMinutes} minutes logged)`}
                  aria-pressed={selected}
                  className={cn(
                    "flex flex-col items-center rounded py-0.5 font-mono text-[10px] transition-colors",
                    selected
                      ? "bg-cyan/15 text-cyan"
                      : "text-muted-foreground hover:text-foreground",
                  )}
                >
                  <span
                    aria-hidden
                    className={cn(
                      "mb-0.5 size-1 rounded-full",
                      hasLogs ? "bg-cyan" : "bg-white/15",
                    )}
                  />
                  <span>{d.shortLabel.split(" ")[1] ?? d.shortLabel}</span>
                </button>
              );
            })}
          </div>
        ) : (
          <div className="flex items-center justify-between font-mono text-[10px] text-muted-foreground">
            <span>{timeline.days[0]?.shortLabel}</span>
            <span>{timeline.days[Math.floor(maxIndex / 2)]?.shortLabel}</span>
            <span>{timeline.days[maxIndex]?.shortLabel}</span>
          </div>
        )}
      </div>
    </div>
  );
}
</file>

<file path="src/features/brain/shaders/brainPoints.ts">
/**
 * Particle-brain shaders (GLSL strings for THREE.ShaderMaterial).
 * three injects: position, normal, modelViewMatrix, projectionMatrix, normalMatrix.
 */

export const brainPointsVertex = /* glsl */ `
// ---- Global ---------------------------------------------------------------
uniform float uTime;
uniform float uPixelRatio;
uniform float uSize;          // point size in px at distance 1
uniform float uQuality;       // 0 low .. 1 high
uniform float uMotion;        // 0 reduced motion .. 1 full
uniform float uContrast;      // 0 standard .. 1 high-contrast mode
// ---- Mode + region state (all damped on the CPU, never popped) ------------
uniform vec3  uModeW;         // weights: x anatomy, y functional, z activity
uniform float uSelected;      // exact selected index (-1 none)
uniform float uHovered;       // exact hovered index (-1 none)
uniform float uSelectW[8];
uniform float uHoverW[8];
uniform float uActivity[8];   // 0..1 educational association strength
uniform float uIsolateW;      // 0 normal .. 1 hide non-selected regions
uniform float uCompareW;      // 0 normal .. 1 compare mode active
uniform float uCompareA[8];   // 0..1 weights for Activity A (violet)
uniform float uCompareB[8];   // 0..1 weights for Activity B (cyan)
uniform float uCutW;          // 0 normal .. 1 cross-section cut active
uniform vec3  uCutNormal;     // unit normal for cross-section plane
uniform float uCutPos;        // plane offset along uCutNormal
uniform float uAnySelected;
uniform float uInternalVis;   // visibility of deep structures
uniform float uCortexAlpha;   // cortex opacity multiplier
uniform vec3  uAnatomyColor[8];
uniform vec3  uFuncColor[8];
uniform vec3  uCentroid[8];   // right-side anchors; mirrored with abs(x)
uniform vec3  uViolet;
uniform vec3  uCyan;
uniform vec3  uDim;
// ---- Hero ----------------------------------------------------------------
uniform float uProgress;      // 0 nebula .. 1 converged brain
uniform float uTint;          // violet->cyan gradient amount
uniform vec2  uPointer;       // NDC
uniform float uPointerAmt;

attribute float aRegion;
attribute float aSeed;
attribute float aKind;        // 0 surface, 1 inner volume, 2 deep structure
attribute float aFold;        // 0 sulcus .. 1 gyral crown
attribute vec3  aScatter;

varying vec3  vColor;
varying float vAlpha;

float band(float x, float w) { return smoothstep(0.0, w * 0.35, x) * smoothstep(w, w * 0.35, x); }

void main() {
  int   r   = int(aRegion + 0.5);
  float sel = uSelectW[r];
  float hov = uHoverW[r];
  float act = uActivity[r];
  float t   = uTime;

  // 1. HERO CONVERGENCE: staggered per point, swirling in from the nebula
  float start = aSeed * 0.45;
  float conv  = smoothstep(start, start + 0.55, uProgress);
  float swirl = (1.0 - conv) * (2.4 + t * 0.03 * uMotion);
  float cs = cos(swirl), sn = sin(swirl);
  vec3 sc = vec3(cs * aScatter.x - sn * aScatter.z, aScatter.y, sn * aScatter.x + cs * aScatter.z);
  vec3 p  = mix(sc, position, conv);

  // 2. BREATHING: analytic curl of a sin potential (divergence-free) + slow swell
  float bt = t * mix(0.12, 0.4, uMotion);
  vec3 q = p * 2.3 + aSeed * 0.7;
  vec3 curl = vec3(cos(q.z + bt), cos(q.x + bt * 1.3), cos(q.y + bt * 0.7))
            + 0.5 * vec3(cos(2.0 * q.y - bt), cos(2.0 * q.z - bt * 1.1), cos(2.0 * q.x - bt * 0.9));
  p += curl * (0.005 + (1.0 - conv) * 0.05);
  p *= 1.0 + 0.006 * sin(bt * 1.4);

  // 3. PULSE WAVES travelling across the surface
  float w1 = fract(p.z * 0.35 - t * 0.08 + aFold * 0.04);
  vec3 src = vec3(sin(t * 0.07) * 0.7, 0.45, cos(t * 0.05) * 0.8);
  float w2 = fract(distance(p, src) * 0.6 - t * 0.12);
  float pulse = (band(w1, 0.06) + 0.7 * band(w2, 0.05)) * uMotion;

  // 4. ACTIVITY PULSES: rings expanding from active regions
  vec3 qa = vec3(abs(p.x), p.y, p.z);
  float actPulse = 0.0;
  for (int i = 0; i < 7; i++) {
    float a = uActivity[i];
    if (a < 0.02) continue;
    float ph = fract(t * 0.3 + float(i) * 0.137);
    float d = distance(qa, uCentroid[i]) - ph * 0.95;
    actPulse += a * exp(-d * d * 220.0) * (1.0 - ph);
  }
  actPulse *= uModeW.z * uMotion;

  // 5. COLOUR: blend the mode palettes and Compare overlay by damped weights
  vec3 actHue = mix(uViolet, uCyan, act);
  vec3 actCol = mix(uDim, actHue, smoothstep(0.02, 0.2, act)) * mix(0.35, 1.3, act);
  vec3 baseCol = uAnatomyColor[r] * uModeW.x + uFuncColor[r] * uModeW.y + actCol * uModeW.z;
  baseCol += actHue * actPulse * 0.9;

  float cA = uCompareA[r];
  float cB = uCompareB[r];
  float hasA = step(0.02, cA);
  float hasB = step(0.02, cB);
  float isOverlap = hasA * hasB;
  vec3 onlyACol = uViolet * mix(0.65, 1.35, cA);
  vec3 onlyBCol = uCyan * mix(0.65, 1.35, cB);
  vec3 overlapBase = mix(mix(uViolet, uCyan, 0.5), vec3(0.95, 0.98, 1.0), 0.72);
  float overlapShimmer = 1.0 + 0.14 * sin(t * 2.4 + aSeed * 18.0) * uMotion;
  vec3 overlapCol = overlapBase * mix(1.05, 1.48, max(cA, cB)) * overlapShimmer;
  vec3 compCol = uDim * 0.35;
  compCol = mix(compCol, onlyACol, hasA);
  compCol = mix(compCol, onlyBCol, hasB * (1.0 - hasA));
  compCol = mix(compCol, overlapCol, isOverlap);

  vec3 col = mix(baseCol, compCol, uCompareW);
  vec3 grad = mix(uViolet, uCyan, smoothstep(-0.9, 0.9, p.z + p.y * 0.4)) * 0.6;
  col = mix(col, grad, uTint);

  // 6. VIEW-SPACE TERMS
  vec4 mv = modelViewMatrix * vec4(p, 1.0);
  float depth = max(-mv.z, 0.001);
  vec3 nV = normalize(normalMatrix * normal);
  float rim = pow(1.0 - abs(dot(nV, normalize(-mv.xyz))), 2.5);   // fresnel-like
  float isSurf  = 1.0 - step(0.5, aKind);
  float isInner = step(0.5, aKind) * (1.0 - step(1.5, aKind));
  float isDeep  = step(1.5, aKind);

  // Cross-section cut term (keep steady against subtle curl by testing rest position)
  float cutDist = dot(position, uCutNormal) - uCutPos;
  float cutRim = exp(-cutDist * cutDist * 520.0) * uCutW;
  col = mix(col, mix(uCyan, vec3(0.95), 0.35), cutRim * 0.55 * (1.0 - isDeep));

  // 7. BRIGHTNESS: folds, rim, pulses, hover, selection, isolation
  float b = mix(0.32, 1.0, aFold) * (0.8 + rim * 0.9 * isSurf);
  b += pulse * 0.5;
  b *= 1.0 + hov * 0.8;
  b *= mix(1.0, mix(mix(0.15, 0.55, uCompareW), 1.5, sel), uAnySelected);
  b *= mix(1.0, 1.15, uIsolateW * sel);
  b *= mix(1.0, 1.38, uContrast);
  float exact = 1.0 - step(0.5, abs(aRegion - uSelected));
  b += exact * uMotion * 0.2 * (0.5 + 0.5 * sin(t * 2.5 + aSeed * 40.0));
  b += (1.0 - step(0.5, abs(aRegion - uHovered))) * 0.05;
  vec4 clip = projectionMatrix * mv;
  vec2 dp = clip.xy / clip.w - uPointer;
  b += exp(-dot(dp, dp) * 14.0) * uPointerAmt * 0.45;

  // 8. ALPHA: layer visibility + isolation + cut plane + depth fade + near-camera fade
  float alpha = 0.55 * mix(1.5, 1.0, uQuality);
  alpha *= mix(1.0, uCortexAlpha, isSurf);
  alpha *= mix(1.0, 0.22, isInner);
  float cmpDeep = max(cA, cB) * uCompareW;
  float deepVis = clamp(uInternalVis + sel * 1.2 + act * uModeW.z + cmpDeep + uCutW * 0.75, 0.0, 1.0);
  alpha *= mix(1.0, deepVis * 1.5, isDeep);
  alpha *= mix(1.0, clamp(sel * 1.15, 0.0, 1.0), uIsolateW);
  float cutShellMask = 1.0 - smoothstep(-0.03, 0.08, cutDist);
  float cutDeepMask = mix(1.0, 0.52, smoothstep(0.02, 0.16, cutDist));
  alpha *= mix(1.0, mix(cutShellMask, cutDeepMask, isDeep), uCutW);
  float center = -(modelViewMatrix * vec4(0.0, 0.0, 0.0, 1.0)).z;
  alpha *= 1.0 - 0.6 * smoothstep(-0.4, 1.0, depth - center);
  alpha *= smoothstep(0.04, 0.4, depth);
  alpha *= mix(0.45, 1.0, conv);
  alpha = clamp(alpha * mix(1.0, 1.28, uContrast), 0.0, 1.0);

  vColor = col * b;
  vAlpha = alpha;
  gl_Position = clip;
  float size = uSize * (0.55 + aSeed * 0.9) * (1.0 + isDeep * 0.3 + hov * 0.25 + sel * uAnySelected * 0.3);
  gl_PointSize = clamp(size * uPixelRatio / depth, 0.0, 48.0);
}
`;

export const brainPointsFragment = /* glsl */ `
varying vec3  vColor;
varying float vAlpha;

void main() {
  if (vAlpha < 0.003) discard;
  // Soft round sprite with a gaussian falloff.
  vec2 c = gl_PointCoord - 0.5;
  float d = dot(c, c) * 4.0;
  if (d > 1.0) discard;
  gl_FragColor = vec4(vColor, exp(-d * 3.2) * vAlpha);
  #include <colorspace_fragment>
}
`;

/* ---- Neural connection arcs (lines + travelling pulse points) ------------ */
export const connectionVertex = /* glsl */ `
uniform float uTime;
uniform float uMotion;
uniform float uPixelRatio;
uniform float uPulseSize;
uniform vec3  uModeW;
uniform float uSelectW[8];
uniform float uAnySelected;
uniform float uIsolateW;
uniform float uCutW;
uniform vec3  uCutNormal;
uniform float uCutPos;

attribute float aT;        // 0..1 along the arc
attribute float aOffset;   // per-arc phase
attribute vec2  aPair;     // region indices of both ends

varying float vT;
varying float vVis;
varying float vPulse;

void main() {
  float selVis = max(uSelectW[int(aPair.x + 0.5)], uSelectW[int(aPair.y + 0.5)]);
  // Functional mode shows all arcs; a selection shows only its own. Hide in isolation or beyond cut.
  vVis = clamp(uModeW.y * mix(1.0, 0.3, uAnySelected) + selVis, 0.0, 1.0);
  vVis *= (1.0 - uIsolateW);
  float cutDist = dot(position, uCutNormal) - uCutPos;
  vVis *= mix(1.0, 1.0 - smoothstep(-0.03, 0.08, cutDist), uCutW);
  float head = fract(uTime * 0.22 + aOffset);
  float dt = aT - head;
  vPulse = exp(-dt * dt * 220.0) * uMotion;
  vT = aT;
  vec4 mv = modelViewMatrix * vec4(position, 1.0);
  gl_Position = projectionMatrix * mv;
  gl_PointSize = clamp(uPulseSize * uPixelRatio * (0.25 + vPulse) / max(-mv.z, 0.05), 0.0, 32.0);
}
`;

export const connectionLineFragment = /* glsl */ `
uniform vec3 uViolet;
uniform vec3 uCyan;
varying float vT;
varying float vVis;
varying float vPulse;

void main() {
  if (vVis < 0.005) discard;
  float ends = smoothstep(0.0, 0.08, vT) * smoothstep(1.0, 0.92, vT);
  gl_FragColor = vec4(mix(uViolet, uCyan, vT), vVis * (0.22 + vPulse * 0.9) * ends);
  #include <colorspace_fragment>
}
`;

export const connectionPulseFragment = /* glsl */ `
uniform vec3 uViolet;
uniform vec3 uCyan;
varying float vT;
varying float vVis;
varying float vPulse;

void main() {
  vec2 c = gl_PointCoord - 0.5;
  float d = dot(c, c) * 4.0;
  if (d > 1.0 || vVis * vPulse < 0.01) discard;
  // > 1.0 so only these bright heads cross the bloom threshold.
  gl_FragColor = vec4(mix(uViolet, uCyan, vT) * 1.6, exp(-d * 4.0) * vVis * vPulse);
  #include <colorspace_fragment>
}
`;
</file>

<file path="src/features/brain/brainActivity.ts">
import { format, startOfDay, subDays } from "date-fns";

import {
  ACTIVITY_META,
  ACTIVITY_REGION_MAP,
  BRAIN_REGIONS,
  activityToRegionIntensity,
} from "@/data/brainRegions";
import type {
  ActivityKind,
  ActivityLog,
  FocusSession,
  Habit,
  HabitLog,
  ISODate,
  LearningMethod,
  MindfulnessSession,
  MovementLog,
  RegionId,
  SleepLog,
} from "@/types/domain";

const METHOD_TO_ACTIVITY: Record<LearningMethod, ActivityKind> = {
  active_recall: "active_recall",
  spaced_repetition: "spaced_repetition",
  problem_solving: "problem_solving",
  deep_reading: "reading",
  skill_practice: "skill_practice",
  teaching: "teaching",
};

const REGION_NAME_BY_ID: Record<RegionId, string> = Object.fromEntries(
  BRAIN_REGIONS.map((r) => [r.id, r.name]),
) as Record<RegionId, string>;

function inferHabitActivityKind(name: string): ActivityKind {
  const lower = name.toLowerCase();
  if (lower.includes("meditat") || lower.includes("mindful") || lower.includes("breath")) {
    return "mindfulness";
  }
  if (lower.includes("read")) return "reading";
  if (
    lower.includes("outdoor") ||
    lower.includes("walk") ||
    lower.includes("stretch") ||
    lower.includes("run") ||
    lower.includes("exercise")
  ) {
    return "exercise";
  }
  if (lower.includes("music")) return "music";
  if (lower.includes("language")) return "language_learning";
  if (lower.includes("journal") || lower.includes("write") || lower.includes("draw")) {
    return "creative";
  }
  return "mindfulness";
}

export interface LoggedActivitySummary {
  kind: ActivityKind;
  label: string;
  minutes: number;
  count: number;
}

export interface BrainActivitySources {
  focus: readonly FocusSession[];
  movement: readonly MovementLog[];
  sleep: readonly SleepLog[];
  habits: readonly Habit[];
  habitLogs: readonly HabitLog[];
  mindfulness?: readonly MindfulnessSession[];
  activities?: readonly ActivityLog[];
}

export interface BrainTimelineSnapshot {
  items: LoggedActivitySummary[];
  regionIntensity: Partial<Record<RegionId, number>>;
  totalMinutes: number;
}

export interface BrainTimelineDay {
  date: ISODate;
  shortLabel: string;
  dayOnly: BrainTimelineSnapshot;
  cumulative: BrainTimelineSnapshot;
}

export interface BrainTimelineData {
  windowDays: 7 | 30;
  windowStart: ISODate;
  windowEnd: ISODate;
  days: BrainTimelineDay[];
}

export interface ImpactRegionBar {
  region: RegionId;
  regionName: string;
  weight: number;
}

export interface RankedImpactActivity {
  kind: ActivityKind;
  label: string;
  minutes: number;
  count: number;
  regions: ImpactRegionBar[];
}

export interface RegionContributionItem {
  kind: ActivityKind;
  label: string;
  minutes: number;
  count: number;
  weight: number;
  weightedMinutes: number;
  share: number;
  explanation: string;
}

function summarizeRawMap(
  counts: ReadonlyMap<ActivityKind, { minutes: number; count: number }>,
): LoggedActivitySummary[] {
  return [...counts.entries()]
    .map(([kind, stats]) => ({
      kind,
      label: ACTIVITY_META[kind].label,
      minutes: stats.minutes,
      count: stats.count,
    }))
    .sort((a, b) => b.minutes - a.minutes || a.label.localeCompare(b.label));
}

function collectRawEventsByDate(
  params: BrainActivitySources,
  windowStart: ISODate,
  windowEnd: ISODate,
): Map<ISODate, { kind: ActivityKind; minutes: number }[]> {
  const byDate = new Map<ISODate, { kind: ActivityKind; minutes: number }[]>();
  const add = (date: ISODate, kind: ActivityKind, minutes: number) => {
    if (minutes <= 0 || date < windowStart || date > windowEnd) return;
    const list = byDate.get(date);
    if (list) list.push({ kind, minutes });
    else byDate.set(date, [{ kind, minutes }]);
  };

  for (const f of params.focus) {
    add(f.date, METHOD_TO_ACTIVITY[f.method], f.durationMin);
  }
  for (const m of params.movement) {
    add(m.date, "exercise", m.durationMin);
  }
  for (const s of params.sleep) {
    // Scale sleep nights modestly so a single night complements waking activities.
    add(s.date, "sleep_rest", Math.max(15, Math.round(s.durationMin / 16)));
  }

  const habitNameById = new Map(params.habits.map((h) => [h.id, h.name]));
  for (const hl of params.habitLogs) {
    if (!hl.done) continue;
    const habitName = habitNameById.get(hl.habitId) ?? "";
    add(hl.date, inferHabitActivityKind(habitName), 15);
  }
  for (const ms of params.mindfulness ?? []) {
    add(ms.date, "mindfulness", ms.durationMin);
  }
  for (const act of params.activities ?? []) {
    add(act.date, act.type, act.durationMin);
  }

  return byDate;
}

export function deriveWeeklyBrainActivity(
  params: BrainActivitySources & { today?: Date },
): {
  activity: Partial<Record<RegionId, number>>;
  items: LoggedActivitySummary[];
  windowStart: ISODate;
  windowEnd: ISODate;
} {
  const end = startOfDay(params.today ?? new Date());
  const start = subDays(end, 6);
  const windowStart = format(start, "yyyy-MM-dd");
  const windowEnd = format(end, "yyyy-MM-dd");

  const byDate = collectRawEventsByDate(params, windowStart, windowEnd);
  const rawItems: { kind: ActivityKind; minutes: number }[] = [];
  const counts = new Map<ActivityKind, { minutes: number; count: number }>();

  for (const dayEvents of byDate.values()) {
    for (const ev of dayEvents) {
      rawItems.push(ev);
      const prev = counts.get(ev.kind) ?? { minutes: 0, count: 0 };
      counts.set(ev.kind, { minutes: prev.minutes + ev.minutes, count: prev.count + 1 });
    }
  }

  return {
    activity: activityToRegionIntensity(rawItems),
    items: summarizeRawMap(counts),
    windowStart,
    windowEnd,
  };
}

/**
 * Pre-computes per-day and cumulative region intensities across a 7- or 30-day window
 * so scrubbing the time slider updates shader uniforms without recomputing aggregations.
 */
export function deriveBrainTimeline(
  params: BrainActivitySources & { windowDays: 7 | 30; today?: Date },
): BrainTimelineData {
  const end = startOfDay(params.today ?? new Date());
  const start = subDays(end, params.windowDays - 1);
  const windowStart = format(start, "yyyy-MM-dd");
  const windowEnd = format(end, "yyyy-MM-dd");

  const byDate = collectRawEventsByDate(params, windowStart, windowEnd);
  const cumCounts = new Map<ActivityKind, { minutes: number; count: number }>();
  const cumRawItems: { kind: ActivityKind; minutes: number }[] = [];
  let cumTotalMinutes = 0;

  const days: BrainTimelineDay[] = [];

  for (let offset = params.windowDays - 1; offset >= 0; offset -= 1) {
    const dayDate = subDays(end, offset);
    const iso = format(dayDate, "yyyy-MM-dd");
    const shortLabel = format(dayDate, "MMM d");
    const dayEvents = byDate.get(iso) ?? [];

    const dayCounts = new Map<ActivityKind, { minutes: number; count: number }>();
    let dayTotalMinutes = 0;

    for (const ev of dayEvents) {
      dayTotalMinutes += ev.minutes;
      const prevDay = dayCounts.get(ev.kind) ?? { minutes: 0, count: 0 };
      dayCounts.set(ev.kind, {
        minutes: prevDay.minutes + ev.minutes,
        count: prevDay.count + 1,
      });

      cumTotalMinutes += ev.minutes;
      cumRawItems.push(ev);
      const prevCum = cumCounts.get(ev.kind) ?? { minutes: 0, count: 0 };
      cumCounts.set(ev.kind, {
        minutes: prevCum.minutes + ev.minutes,
        count: prevCum.count + 1,
      });
    }

    days.push({
      date: iso,
      shortLabel,
      dayOnly: {
        items: summarizeRawMap(dayCounts),
        regionIntensity: activityToRegionIntensity(dayEvents),
        totalMinutes: dayTotalMinutes,
      },
      cumulative: {
        items: summarizeRawMap(cumCounts),
        regionIntensity: activityToRegionIntensity(cumRawItems),
        totalMinutes: cumTotalMinutes,
      },
    });
  }

  return {
    windowDays: params.windowDays,
    windowStart,
    windowEnd,
    days,
  };
}

/**
 * Ranks logged activity types by total minutes descending and pairs each with
 * its illustrative `ACTIVITY_REGION_MAP` educational region bars.
 */
export function rankLoggedActivitiesForImpact(
  items: readonly LoggedActivitySummary[],
): RankedImpactActivity[] {
  return [...items]
    .filter((item) => item.minutes > 0)
    .sort((a, b) => b.minutes - a.minutes || a.label.localeCompare(b.label))
    .map((item) => ({
      kind: item.kind,
      label: item.label,
      minutes: item.minutes,
      count: item.count,
      regions: [...ACTIVITY_REGION_MAP[item.kind]]
        .sort((a, b) => b.weight - a.weight)
        .map((entry) => ({
          region: entry.region,
          regionName: REGION_NAME_BY_ID[entry.region],
          weight: entry.weight,
        })),
    }));
}

/**
 * Computes which logged activities contributed to a specific region's educational glow,
 * with minutes, weighted share of total, and a plain-language non-causal explanation.
 */
export function getRegionImpactContributions(
  regionId: RegionId,
  items: readonly LoggedActivitySummary[],
): RegionContributionItem[] {
  const regionName = REGION_NAME_BY_ID[regionId];
  const matches: Array<{
    item: LoggedActivitySummary;
    weight: number;
    weightedMinutes: number;
  }> = [];
  let totalWeighted = 0;

  for (const item of items) {
    if (item.minutes <= 0) continue;
    const mapping = ACTIVITY_REGION_MAP[item.kind].find((m) => m.region === regionId);
    if (!mapping || mapping.weight <= 0) continue;
    const weightedMinutes = item.minutes * mapping.weight;
    totalWeighted += weightedMinutes;
    matches.push({ item, weight: mapping.weight, weightedMinutes });
  }

  if (totalWeighted <= 0) return [];

  return matches
    .sort((a, b) => b.weightedMinutes - a.weightedMinutes || a.item.label.localeCompare(b.item.label))
    .map(({ item, weight, weightedMinutes }) => {
      const meta = ACTIVITY_META[item.kind];
      return {
        kind: item.kind,
        label: item.label,
        minutes: item.minutes,
        count: item.count,
        weight,
        weightedMinutes,
        share: weightedMinutes / totalWeighted,
        explanation: `${meta.label} (${meta.description.replace(/\.$/, "")}) is commonly associated with ${regionName} based on what you logged.`,
      };
    });
}

/**
 * Returns true if the user has any logged entries across the brain activity tables
 * (used to gate the "Load demo data" shortcut in empty states).
 */
export function hasAnyBrainActivityData(params: BrainActivitySources): boolean {
  return (
    params.focus.length > 0 ||
    params.movement.length > 0 ||
    params.sleep.length > 0 ||
    params.habitLogs.some((h) => h.done) ||
    (params.mindfulness?.length ?? 0) > 0 ||
    (params.activities?.length ?? 0) > 0
  );
}
</file>

<file path="src/features/brain/brainCompare.test.ts">
import { describe, expect, it } from "vitest";

import { ACTIVITY_META } from "@/data/brainRegions";
import { REGION_SLOTS } from "./regionZones";
import {
  compareActivities,
  compareToSlotWeights,
  pickDefaultComparePartner,
} from "./brainCompare";

describe("brainCompare", () => {
  it("computes shared overlap and distinct regions for partially overlapping activities", () => {
    // deep_focus: prefrontal (1.0), parietal (0.7)
    // active_recall: hippocampus (1.0), prefrontal (0.8), temporal (0.5)
    const result = compareActivities("deep_focus", "active_recall");

    expect(result.sameActivity).toBe(false);
    expect(result.sharedRegions.map((r) => r.regionId)).toEqual(["prefrontal"]);
    expect(result.onlyARegions.map((r) => r.regionId)).toEqual(["parietal"]);
    expect(result.onlyBRegions.map((r) => r.regionId)).toEqual(["hippocampus", "temporal"]);

    expect(result.byRegion.prefrontal.status).toBe("both");
    expect(result.byRegion.parietal.status).toBe("onlyA");
    expect(result.byRegion.hippocampus.status).toBe("onlyB");
    expect(result.byRegion.occipital.status).toBe("none");

    expect(result.summary).toContain("Deep focus");
    expect(result.summary).toContain("Active recall");
    expect(result.summary).toContain("Prefrontal Cortex");
    expect(result.summary).toContain("Parietal Lobe");
    expect(result.summary).toContain("Hippocampus");
    expect(result.summary.toLowerCase()).not.toContain("measure");
  });

  it("handles activities with zero regional overlap cleanly", () => {
    // exercise: cerebellum (1.0), parietal (0.6)
    // mindfulness: prefrontal (0.8), amygdala (0.6)
    const result = compareActivities("exercise", "mindfulness");

    expect(result.sharedRegions).toEqual([]);
    expect(result.onlyARegions.map((r) => r.regionId)).toEqual(["cerebellum", "parietal"]);
    expect(result.onlyBRegions.map((r) => r.regionId)).toEqual(["prefrontal", "amygdala"]);
    expect(result.summary).toContain("no overlap");
  });

  it("handles activities that map to the exact same region set with different weights", () => {
    // active_recall and spaced_repetition both map to hippocampus, prefrontal, temporal
    const result = compareActivities("active_recall", "spaced_repetition");

    expect(result.sameActivity).toBe(false);
    expect(result.sharedRegions.map((r) => r.regionId)).toEqual([
      "hippocampus",
      "prefrontal",
      "temporal",
    ]);
    expect(result.onlyARegions).toEqual([]);
    expect(result.onlyBRegions).toEqual([]);
    expect(result.summary).toContain("same set of regions");
  });

  it("handles selecting the exact same activity in both slots", () => {
    const result = compareActivities("sleep_rest", "sleep_rest");

    expect(result.sameActivity).toBe(true);
    expect(result.sharedRegions.map((r) => r.regionId)).toEqual(["hippocampus"]);
    expect(result.onlyARegions).toEqual([]);
    expect(result.onlyBRegions).toEqual([]);
    expect(result.summary).toContain(ACTIVITY_META.sleep_rest.label);
  });

  it("builds fixed-length uniform arrays and detects internal regions", () => {
    const deepPair = compareToSlotWeights("deep_focus", "sleep_rest");
    expect(deepPair.weightsA).toHaveLength(REGION_SLOTS);
    expect(deepPair.weightsB).toHaveLength(REGION_SLOTS);
    expect(deepPair.weightsA[0]).toBe(1.0); // prefrontal
    expect(deepPair.weightsB[5]).toBe(0.9); // hippocampus
    expect(deepPair.weightsA[7]).toBe(0); // unassigned slot
    expect(deepPair.involvesDeep).toBe(true);

    const surfacePair = compareToSlotWeights("deep_focus", "exercise");
    expect(surfacePair.involvesDeep).toBe(false);
  });

  it("picks a distinct comparison partner when jumping from related activities", () => {
    expect(pickDefaultComparePartner("deep_focus", "mindfulness")).toBe("mindfulness");
    expect(pickDefaultComparePartner("mindfulness", "mindfulness")).not.toBe("mindfulness");
    expect(pickDefaultComparePartner("deep_focus")).not.toBe("deep_focus");
  });
});
