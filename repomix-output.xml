// @vitest-environment jsdom
import { act } from "react";
import { createRoot, type Root } from "react-dom/client";
import { afterEach, beforeAll, describe, expect, it, vi } from "vitest";

import { usePanelLayout } from "@/components/floating";
import { ALL_NAV_ITEMS } from "@/components/app-shell/nav-items";
import { TooltipProvider } from "@/components/ui/tooltip";
import { generateDemoData } from "@/lib/insights";
import { deriveConstellation } from "@/features/constellation/constellation";
import { ConstellationWorkspace } from "./ConstellationWorkspace";

vi.mock("next/navigation", () => ({
  useRouter: () => ({ push: vi.fn(), replace: vi.fn(), prefetch: vi.fn() }),
  usePathname: () => "/constellation",
  useSearchParams: () => new URLSearchParams(),
}));

const BANNED_DOM_PATTERNS = [
  /\bcaus(e|ed|es|ing)\b/i,
  /\bmakes you\b/i,
  /\bleads to\b/i,
  /\bresults in\b/i,
  /\baffected\b/i,
  /\bimproved\b/i,
  /\bstrengthened\b/i,
  /\bboosted\b/i,
  /\bstreak/i,
  /\bbroken\b/i,
  /\bscore\b/i,
  /\bdiagnos/i,
];

function assertCleanDomCopy(text: string) {
  for (const pattern of BANNED_DOM_PATTERNS) {
    expect(text).not.toMatch(pattern);
  }
}

describe("ConstellationWorkspace UI & navigation", () => {
  let root: Root | null = null;
  let container: HTMLElement | null = null;

  beforeAll(() => {
    (globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
    Object.defineProperty(window, "matchMedia", {
      writable: true,
      value: (query: string) => ({
        matches: false,
        media: query,
        onchange: null,
        addListener: vi.fn(),
        removeListener: vi.fn(),
        addEventListener: vi.fn(),
        removeEventListener: vi.fn(),
        dispatchEvent: vi.fn(),
      }),
    });
    if (typeof window.ResizeObserver === "undefined") {
      vi.stubGlobal(
        "ResizeObserver",
        class {
          observe() {}
          unobserve() {}
          disconnect() {}
        },
      );
    }
  });

  afterEach(async () => {
    if (root) {
      await act(async () => {
        root!.unmount();
      });
      root = null;
    }
    if (container) {
      container.remove();
      container = null;
    }
    window.localStorage.clear();
    usePanelLayout.setState({
      hydrated: false,
      topZ: 1,
      panels: {},
      defaults: {},
      measuredSizes: {},
      activeMobilePanelId: null,
    });
  });

  async function renderWorkspace(node: React.ReactNode): Promise<HTMLElement> {
    container = document.createElement("div");
    document.body.appendChild(container);
    root = createRoot(container);
    await act(async () => {
      root!.render(<TooltipProvider>{node}</TooltipProvider>);
    });
    return container;
  }

  it("registers /constellation in ALL_NAV_ITEMS (nav, command palette, and immersive dock)", () => {
    const item = ALL_NAV_ITEMS.find((entry) => entry.href === "/constellation");
    expect(item).toBeDefined();
    expect(item?.label).toBe("Constellation");
  });

  it("shows only explanation and gated Load demo data button when under 10 logged days", async () => {
    const today = new Date("2026-11-17T12:00:00");
    const emptyData = deriveConstellation({
      habits: [],
      habitLogs: [],
      activities: [],
      focus: [],
      movement: [],
      mindfulness: [],
      windowDays: 30,
      today,
    });
    const onLoadDemo = vi.fn().mockResolvedValue(undefined);

    const host = await renderWorkspace(
      <ConstellationWorkspace
        data={emptyData}
        windowDays={30}
        onChangeWindowDays={vi.fn()}
        reducedMotion
        onLoadDemo={onLoadDemo}
      />,
    );

    expect(host.querySelector("[data-constellation-canvas]")).toBeNull();
    expect(host.textContent).toContain("0 of 10 logged days");
    assertCleanDomCopy(host.textContent ?? "");

    const demoBtn = Array.from(host.querySelectorAll("button")).find((b) =>
      b.textContent?.includes("Load demo data"),
    ) as HTMLButtonElement | undefined;
    expect(demoBtn).toBeDefined();
    await act(async () => {
      demoBtn!.click();
    });
    expect(onLoadDemo).toHaveBeenCalledTimes(1);
  });

  it("supports keyboard focus tooltip, floating detail panel with calendar & Log now, and table view toggle", async () => {
    const today = new Date("2026-11-17T12:00:00");
    const demo = generateDemoData(14, 42, today);
    const data = deriveConstellation({
      habits: demo.habits,
      habitLogs: demo.habitLogs,
      activities: [],
      focus: demo.focus,
      movement: demo.movement,
      mindfulness: [],
      windowDays: 30,
      today,
    });

    const host = await renderWorkspace(
      <ConstellationWorkspace
        data={data}
        windowDays={30}
        onChangeWindowDays={vi.fn()}
        reducedMotion
      />,
    );

    assertCleanDomCopy(host.textContent ?? "");
    const firstStar = host.querySelector("[data-star-id]") as SVGGElement;
    expect(firstStar).not.toBeNull();

    // Focus opens tooltip without requiring mouse hover
    await act(async () => {
      firstStar.dispatchEvent(new FocusEvent("focusin", { bubbles: true }));
    });
    expect(host.querySelector("[data-constellation-tooltip]")).not.toBeNull();

    // Pressing Enter opens floating detail panel with mini calendar + "Log now" link
    await act(async () => {
      firstStar.dispatchEvent(new KeyboardEvent("keydown", { key: "Enter", bubbles: true }));
    });
    const detailPanel = host.querySelector('[data-panel-id="constellation-detail"]') as HTMLElement;
    expect(detailPanel).not.toBeNull();
    expect(detailPanel.querySelector('[role="grid"]')).not.toBeNull();
    const logNowLink = Array.from(detailPanel.querySelectorAll("a")).find((a) =>
      a.textContent?.includes("Log now"),
    );
    expect(logNowLink).toBeDefined();
    assertCleanDomCopy(detailPanel.textContent ?? "");

    // Switch to Table view for accessible alternative
    const tableBtn = host.querySelector('button[aria-label="Table view"]') as HTMLButtonElement;
    expect(tableBtn).not.toBeNull();
    await act(async () => {
      tableBtn.click();
    });
    const table = host.querySelector("table");
    expect(table).not.toBeNull();
    expect(table!.textContent).toContain("happened on the same day");
    assertCleanDomCopy(table!.textContent ?? "");
  });
});
</file>

<file path="src/features/constellation/components/ConstellationWorkspace.tsx">
"use client";

import { useCallback, useMemo, useState } from "react";
import Link from "next/link";
import { Orbit, Sparkles, Table as TableIcon } from "lucide-react";

import { usePanelLayout } from "@/components/floating";
import { PageHeader } from "@/components/nx";
import { Button } from "@/components/ui/button";
import { Skeleton } from "@/components/ui/skeleton";
import { ToggleGroup, ToggleGroupItem } from "@/components/ui/toggle-group";
import {
  CONSTELLATION_CAVEAT,
  CONSTELLATION_WINDOW_OPTIONS,
  formatSameDayCount,
  getCoOccurrencesForNode,
  type ConstellationData,
  type ConstellationWindowDays,
} from "@/features/constellation/constellation";
import { ConstellationCanvas } from "./ConstellationCanvas";
import { ConstellationDetailPanel } from "./ConstellationDetailPanel";
import { ConstellationTableView } from "./ConstellationTableView";

export interface ConstellationWorkspaceProps {
  data: ConstellationData;
  windowDays: ConstellationWindowDays;
  onChangeWindowDays: (days: ConstellationWindowDays) => void;
  reducedMotion: boolean;
  onLoadDemo?: () => Promise<void>;
}

export function ConstellationSkeleton() {
  return (
    <div className="space-y-6">
      <div className="space-y-2">
        <Skeleton className="h-8 w-48" />
        <Skeleton className="h-4 w-96 max-w-full" />
      </div>
      <Skeleton className="h-[460px] w-full rounded-card" />
    </div>
  );
}

export function ConstellationWorkspace({
  data,
  windowDays,
  onChangeWindowDays,
  reducedMotion,
  onLoadDemo,
}: ConstellationWorkspaceProps) {
  const [viewMode, setViewMode] = useState<"map" | "table">("map");
  const [selectedNodeId, setSelectedNodeId] = useState<string | null>(null);
  const [loadingDemo, setLoadingDemo] = useState(false);

  const selectedNode = useMemo(
    () => (selectedNodeId ? (data.nodes.find((n) => n.id === selectedNodeId) ?? null) : null),
    [data.nodes, selectedNodeId],
  );

  const handleSelectNode = useCallback((nextId: string | null) => {
    setSelectedNodeId(nextId);
    if (nextId) {
      usePanelLayout.getState().setMobileActivePanel("constellation-detail");
    } else {
      usePanelLayout.getState().setMobileActivePanel(null);
    }
  }, []);

  const handleLoadDemo = async () => {
    if (!onLoadDemo || loadingDemo) return;
    setLoadingDemo(true);
    try {
      await onLoadDemo();
    } finally {
      setLoadingDemo(false);
    }
  };

  const selectedAnnouncement = useMemo(() => {
    if (!selectedNode) return data.summaryText;
    const links = getCoOccurrencesForNode(selectedNode.id, data.nodes, data.edges, 3);
    const linkSummary =
      links.length > 0
        ? links.map((l) => `${l.label} (${formatSameDayCount(l.sharedDays)})`).join("; ")
        : "no connections with 3 or more shared days";
    return `Selected ${selectedNode.label}: present on ${selectedNode.daysPresent} days; ${linkSummary}.`;
  }, [data.edges, data.nodes, data.summaryText, selectedNode]);

  return (
    <div className="space-y-6">
      <PageHeader
        title="Constellation"
        description="Your habits and logged activities arranged by how often they happened on the same day."
        actions={
          <div className="flex flex-wrap items-center gap-2">
            <ToggleGroup
              type="single"
              value={String(windowDays)}
              onValueChange={(v) => {
                const parsed = Number(v);
                if (parsed === 14 || parsed === 30 || parsed === 90) {
                  onChangeWindowDays(parsed);
                }
              }}
              variant="outline"
              size="sm"
              aria-label="Constellation time window"
            >
              {CONSTELLATION_WINDOW_OPTIONS.map((days) => (
                <ToggleGroupItem
                  key={days}
                  value={String(days)}
                  className="font-mono text-caption"
                >
                  {days}d
                </ToggleGroupItem>
              ))}
            </ToggleGroup>

            {data.meetsMinDays ? (
              <ToggleGroup
                type="single"
                value={viewMode}
                onValueChange={(v) => {
                  if (v === "map" || v === "table") setViewMode(v);
                }}
                variant="outline"
                size="sm"
                aria-label="Constellation view mode"
              >
                <ToggleGroupItem value="map" aria-label="Starfield map view" className="gap-1.5 text-caption">
                  <Orbit className="size-3.5" aria-hidden />
                  <span>Map</span>
                </ToggleGroupItem>
                <ToggleGroupItem value="table" aria-label="Table view" className="gap-1.5 text-caption">
                  <TableIcon className="size-3.5" aria-hidden />
                  <span>Table</span>
                </ToggleGroupItem>
              </ToggleGroup>
            ) : null}
          </div>
        }
      />

      <p className="sr-only" aria-live="polite">
        {selectedAnnouncement}
      </p>

      {!data.meetsMinDays ? (
        <section
          aria-label="Constellation minimum days requirement"
          className="rounded-card border border-border bg-surface p-6 sm:p-8"
        >
          <div className="max-w-xl space-y-4">
            <div className="inline-flex items-center gap-2 rounded-chip border border-cyan/30 bg-cyan/10 px-2.5 py-1 font-mono text-[11px] text-cyan tabular-nums">
              <Orbit className="size-3.5" aria-hidden />
              {data.activeDaysCount} of {data.minDaysRequired} logged days in {windowDays}d
            </div>

            <h2 className="text-section font-semibold text-foreground">
              The constellation opens once you have {data.minDaysRequired} days with logs
            </h2>
            <p className="text-body leading-relaxed text-muted-foreground">
              Same-day links are only meaningful with a few days of history behind them, so
              this map waits until at least {data.minDaysRequired} distinct days appear in the
              selected {windowDays}-day window (with at least 3 shared days before drawing a
              line between two items).
            </p>
            <p className="text-caption leading-relaxed text-muted-foreground">
              Log your daily habits, focus methods, movement, mindfulness sessions, or personal
              activities at your own pace.
            </p>

            <div className="flex flex-wrap items-center gap-2.5 pt-1">
              <Button asChild size="sm" variant="outline" className="rounded-control">
                <Link href="/habits">Go to Daily Habits</Link>
              </Button>
              <Button asChild size="sm" variant="outline" className="rounded-control">
                <Link href="/focus">Open Focus Lab</Link>
              </Button>
              {!data.hasAnyData && onLoadDemo ? (
                <Button
                  type="button"
                  size="sm"
                  disabled={loadingDemo}
                  onClick={handleLoadDemo}
                  className="gap-1.5 rounded-control bg-violet text-white hover:bg-violet/90"
                >
                  <Sparkles className="size-3.5" aria-hidden />
                  {loadingDemo ? "Loading demo data…" : "Load demo data"}
                </Button>
              ) : null}
            </div>
          </div>
        </section>
      ) : (
        <div className="space-y-3">
          {/* Quiet informational status strip */}
          <div className="flex flex-wrap items-center justify-between gap-2 text-caption text-muted-foreground">
            <p className="tabular-nums">
              Showing <span className="font-mono text-foreground">{data.nodes.length}</span>{" "}
              {data.nodes.length === 1 ? "entry" : "entries"} and{" "}
              <span className="font-mono text-foreground">{data.edges.length}</span> same-day{" "}
              {data.edges.length === 1 ? "connection" : "connections"} across{" "}
              <span className="font-mono text-cyan">{data.activeDaysCount}</span> logged days (
              {data.windowStart} → {data.windowEnd}).
            </p>
            <p className="font-mono text-[11px] text-muted-foreground">
              Size & brightness = days present · Lines = 3+ same-day matches
            </p>
          </div>

          {viewMode === "map" ? (
            <ConstellationCanvas
              data={data}
              selectedNodeId={selectedNode?.id ?? null}
              onSelectNode={handleSelectNode}
              reducedMotion={reducedMotion}
            />
          ) : (
            <ConstellationTableView
              data={data}
              selectedNodeId={selectedNode?.id ?? null}
              onSelectNode={handleSelectNode}
            />
          )}
        </div>
      )}

      <p
        role="note"
        className="rounded-control border border-border bg-surface/60 px-3.5 py-2.5 text-caption text-muted-foreground"
      >
        {CONSTELLATION_CAVEAT}
      </p>

      {selectedNode ? (
        <ConstellationDetailPanel
          data={data}
          node={selectedNode}
          onSelectNode={handleSelectNode}
          onClose={() => handleSelectNode(null)}
        />
      ) : null}
    </div>
  );
}
