"use client";

import { useEffect, useMemo, useRef, useState } from "react";

import type { IntroMachineState } from "./introMachine";
import { INTRO_TIMING, getExitDurationMs } from "./introMachine";
import { LoaderParticleEngine, computeSilhouetteLayout } from "./loaderParticles";
import {
  IGNITION_ORDER,
  INTRO_DISCLAIMER,
  REGION_CAPTIONS,
} from "./silhouetteData";
import "./intro.css";

export interface IntroLoaderProps {
  state: IntroMachineState;
  onSkip: () => void;
}

const REDUCED_MOTION_SUMMARY =
  "Cortex, cerebellum, hippocampus, and amygdala — planning, spatial attention, language, vision, movement, and memory associations.";

const COARSE_ANNOUNCEMENTS: Record<IntroMachineState["stage"], string> = {
  chunk: "Loading the observatory",
  geometry: "Placing particles",
  shaders: "Compiling shaders",
  firstFrame: "First light",
};

export function IntroLoader({ state, onSkip }: IntroLoaderProps) {
  const overlayRef = useRef<HTMLDivElement>(null);
  const canvasRef = useRef<HTMLCanvasElement>(null);
  const engineRef = useRef<LoaderParticleEngine | null>(null);
  const [hydrated, setHydrated] = useState(false);
  const [shortLandscape, setShortLandscape] = useState(false);

  const isMinimal = state.variant === "minimal";
  const showFullStage = !isMinimal;
  const showCanvas =
    showFullStage &&
    (state.phase === "loading" || state.phase === "ready" || state.phase === "exiting" || state.phase === "skipped");

  useEffect(() => {
    const id = window.requestAnimationFrame(() => setHydrated(true));
    return () => window.cancelAnimationFrame(id);
  }, []);

  // Track short-landscape layout threshold cleanly on resize.
  useEffect(() => {
    const updateHeight = () => {
      setShortLandscape(window.innerHeight < 480);
    };
    updateHeight();
    window.addEventListener("resize", updateHeight, { passive: true });
    return () => window.removeEventListener("resize", updateHeight);
  }, []);

  // Instantiate and clean up 2D particle engine when canvas stage mounts.
  useEffect(() => {
    if (!showFullStage || !state.overlayMounted) return;
    const canvas = canvasRef.current;
    const container = overlayRef.current;
    if (!canvas || !container) return;

    const rect = container.getBoundingClientRect();
    const w = rect.width || window.innerWidth || 1280;
    const h = rect.height || window.innerHeight || 720;
    const engine = new LoaderParticleEngine(canvas, w, h, state.reducedMotion);
    engineRef.current = engine;
    engine.start();

    let ro: ResizeObserver | null = null;
    if (typeof ResizeObserver !== "undefined") {
      ro = new ResizeObserver((entries) => {
        const cr = entries[0]?.contentRect;
        if (cr && cr.width > 0 && cr.height > 0) {
          engine.resize(cr.width, cr.height);
        }
      });
      ro.observe(container);
    }

    const onOrientation = () => {
      const r = container.getBoundingClientRect();
      if (r.width > 0 && r.height > 0) {
        engine.resize(r.width, r.height);
      }
    };
    window.addEventListener("orientationchange", onOrientation, { passive: true });

    return () => {
      window.removeEventListener("orientationchange", onOrientation);
      ro?.disconnect();
      engine.destroy();
      engineRef.current = null;
    };
  }, [showFullStage, state.overlayMounted, state.reducedMotion]);

  // Sync reactive state transitions into particle engine.
  useEffect(() => {
    const engine = engineRef.current;
    if (!engine) return;
    engine.updateState({
      phase: state.phase,
      ignitedCount: state.ignitedCount,
      reducedMotion: state.reducedMotion,
      sweepProgress: state.phase === "exiting" ? 0.15 : 0,
      liftoffProgress: 0,
    });
  }, [state.phase, state.ignitedCount, state.reducedMotion]);

  // Smooth 60fps exit timeline for First Light sweep + star liftoff + radial aperture opening.
  useEffect(() => {
    const overlay = overlayRef.current;
    if (!overlay) return;

    if (state.phase === "skipped") {
      overlay.style.maskImage = "";
      overlay.style.webkitMaskImage = "";
      return;
    }

    if (state.phase !== "exiting" || state.reducedMotion || isMinimal) {
      if (state.phase !== "exiting") {
        overlay.style.maskImage = "";
        overlay.style.webkitMaskImage = "";
      }
      return;
    }

    const start = state.exitingStartedAtMs ?? performance.now();
    const total = getExitDurationMs({
      reducedMotion: state.reducedMotion,
      variant: isMinimal ? "minimal" : "full",
    });
    let rafId = 0;

    const tick = () => {
      const elapsed = Math.max(0, performance.now() - start);
      const t = Math.min(1, elapsed / total);

      // Sweep light gently across silhouette in the first ~600ms (t: 0..0.48)
      const rawSweep = Math.min(1, t / 0.48);
      const sweep = rawSweep * rawSweep * (3 - 2 * rawSweep);
      // Particles lift outward starting softly around 320ms (t: 0.26..1)
      const rawLift = t > 0.26 ? Math.min(1, (t - 0.26) / 0.74) : 0;
      const liftoff = rawLift * rawLift * (3 - 2 * rawLift);

      engineRef.current?.updateState({
        phase: "exiting",
        ignitedCount: IGNITION_ORDER.length,
        reducedMotion: false,
        sweepProgress: sweep,
        liftoffProgress: liftoff,
      });

      // Feathered radial aperture opens smoothly from center of silhouette across t: 0.28..1
      if (t > 0.28) {
        const ap = Math.min(1, (t - 0.28) / 0.72);
        const eased =
          ap < 0.5 ? 4 * ap * ap * ap : 1 - Math.pow(-2 * ap + 2, 3) / 2;
        const radiusPct = eased * 140;
        const rect = overlay.getBoundingClientRect();
        const layout = computeSilhouetteLayout(
          rect.width || window.innerWidth,
          rect.height || window.innerHeight,
        );
        const mask = `radial-gradient(circle at ${layout.cx.toFixed(0)}px ${layout.cy.toFixed(
          0,
        )}px, transparent ${radiusPct.toFixed(1)}%, rgba(0,0,0,0.88) ${(radiusPct + 14).toFixed(
          1,
        )}%, #000 ${(radiusPct + 28).toFixed(1)}%)`;
        overlay.style.maskImage = mask;
        overlay.style.webkitMaskImage = mask;
      }

      if (t < 1) {
        rafId = window.requestAnimationFrame(tick);
      }
    };

    rafId = window.requestAnimationFrame(tick);
    return () => window.cancelAnimationFrame(rafId);
  }, [state.phase, state.exitingStartedAtMs, state.reducedMotion, isMinimal]);

  // Keyboard shortcut (Esc / Enter) triggers Skip cleanly once available.
  useEffect(() => {
    if (!state.overlayMounted || !state.canSkip) return;
    if (state.phase === "exiting" || state.phase === "done" || state.phase === "skipped") return;

    const onKeyDown = (event: KeyboardEvent) => {
      if (event.key === "Escape" || event.key === "Enter") {
        event.preventDefault();
        onSkip();
      }
    };
    window.addEventListener("keydown", onKeyDown);
    return () => window.removeEventListener("keydown", onKeyDown);
  }, [state.overlayMounted, state.canSkip, state.phase, onSkip]);

  // Prevent wheel/touch scrolling of the underlying page while the full overlay locks the viewport.
  useEffect(() => {
    const locked =
      showFullStage &&
      state.overlayMounted &&
      (state.phase === "idle" || state.phase === "loading" || state.phase === "ready");
    if (!locked) return;

    const blockScroll = (e: Event) => {
      if (e.cancelable) e.preventDefault();
    };
    window.addEventListener("wheel", blockScroll, { passive: false, capture: true });
    window.addEventListener("touchmove", blockScroll, { passive: false, capture: true });
    return () => {
      window.removeEventListener("wheel", blockScroll, { capture: true });
      window.removeEventListener("touchmove", blockScroll, { capture: true });
    };
  }, [showFullStage, state.overlayMounted, state.phase]);

  // Compute coarse screen-reader announcement (stage changes + Ready only).
  const announcement = useMemo(() => {
    if (state.phase === "exiting" || state.phase === "done" || state.phase === "skipped") {
      return "Ready";
    }
    return COARSE_ANNOUNCEMENTS[state.stage];
  }, [state.phase, state.stage]);

  if (!state.overlayMounted) {
    return null;
  }

  const activeCaption =
    state.activeRegionIndex !== null
      ? REGION_CAPTIONS[IGNITION_ORDER[state.activeRegionIndex]]
      : null;

  const isSkippingFade = state.phase === "skipped";
  const isReducedOrMinimalExit =
    state.phase === "exiting" && (state.reducedMotion || isMinimal);

  const counterText =
    state.pointsPlaced !== null && state.pointsTotal !== null && state.pointsTotal > 0
      ? `${state.pointsPlaced.toLocaleString("en-US")} / ${state.pointsTotal.toLocaleString("en-US")} points placed`
      : null;

  return (
    <>
      <noscript>
        <style>{".nx-intro-overlay{display:none!important}"}</style>
      </noscript>

      <div
        ref={overlayRef}
        role="status"
        aria-label="NeuroSync First Light loading screen"
        data-phase={state.phase}
        data-variant={state.variant}
        className={`nx-intro-overlay flex flex-col justify-between transition-opacity ${
          isMinimal ? "nx-intro-overlay--minimal" : ""
        } ${
          isSkippingFade
            ? "pointer-events-none opacity-0 duration-250"
            : isReducedOrMinimalExit
              ? "pointer-events-none opacity-0 duration-200"
              : "opacity-100 duration-200"
        }`}
        style={{
          transitionDuration: isSkippingFade
            ? `${INTRO_TIMING.skipFadeMs}ms`
            : isReducedOrMinimalExit
              ? `${INTRO_TIMING.exitReducedMs}ms`
              : undefined,
        }}
      >
        <span className="sr-only" aria-live="polite">
          {announcement}
        </span>

        {/* Minimal repeat-visit hairline bar at viewport top */}
        <div
          aria-hidden="true"
          className={`nx-intro-minimal-bar fixed inset-x-0 top-0 z-10 h-[2px] overflow-hidden bg-white/[0.06] ${
            isMinimal ? "block" : "hidden"
          }`}
        >
          <div
            className="h-full origin-left bg-gradient-to-r from-[#22D3EE] to-[#8B5CF6] transition-transform duration-150 ease-out"
            style={{ transform: `scaleX(${Math.max(0.08, state.progress)})` }}
          />
        </div>

        {/* Full First Light experience */}
        <div className="nx-intro-full-stage relative flex h-full w-full flex-col">
          {/* Interactive 2D silhouette particle canvas fading in after hydration */}
          <canvas
            ref={canvasRef}
            aria-hidden="true"
            className={`pointer-events-none fixed inset-0 h-full w-full transition-opacity duration-500 ${
              hydrated && showCanvas ? "opacity-100" : "opacity-0"
            }`}
          />

          {/* Top bar: mono micro-label & delayed Skip button */}
          <div className="relative z-10 mx-auto flex w-full max-w-7xl flex-none items-center justify-between pt-2">
            <span className="font-mono text-[11px] uppercase tracking-[0.18em] text-[#CBD5E1]">
              NEUROSYNC / 01
            </span>

            {state.canSkip && state.phase !== "exiting" && state.phase !== "skipped" ? (
              <button
                type="button"
                onClick={onSkip}
                className="rounded-md border border-white/[0.18] bg-[#0C1222]/85 px-3 py-1 font-mono text-[11px] uppercase tracking-[0.16em] text-[#E6EAF5] transition-colors hover:border-[#22D3EE]/70 hover:text-[#22D3EE]"
              >
                Skip
              </button>
            ) : null}
          </div>

          {/* Center SSR instant first-paint heartbeat pulse dot (fades cleanly once 2D canvas settles) */}
          <div
            aria-hidden="true"
            className={`pointer-events-none fixed inset-0 flex items-center justify-center transition-opacity duration-300 ${
              hydrated && showCanvas && state.phase !== "idle" ? "opacity-0" : "opacity-100"
            }`}
          >
            <div className="nx-intro-core-dot" />
          </div>

          {/* Caption + hairline progress + disclaimer: bottom centered on tall/normal screens, right beside silhouette on short landscape */}
          <div
            className={`relative z-10 mx-auto flex w-full max-w-7xl flex-1 ${
              shortLandscape ? "items-center justify-end" : "items-end justify-center pb-2"
            }`}
          >
            <div
              className={`flex flex-col gap-3 ${
                shortLandscape
                  ? "w-[46%] items-start pr-2 text-left"
                  : "w-full items-center text-center"
              }`}
            >
              {/* Educational region caption (one line, hedged framing) */}
              <div className="min-h-[2.75rem] max-w-xl">
                {state.phase === "loading" || state.phase === "ready" || state.phase === "exiting" ? (
                  state.reducedMotion ? (
                    <p className="text-xs leading-relaxed text-[#E6EAF5] sm:text-sm">
                      {REDUCED_MOTION_SUMMARY}
                    </p>
                  ) : activeCaption ? (
                    <p
                      key={state.activeRegionIndex}
                      className="nx-intro-caption-enter text-xs leading-relaxed text-[#E6EAF5] sm:text-sm"
                    >
                      {activeCaption}
                    </p>
                  ) : null
                ) : null}
              </div>

              {/* Thin hairline progress + mono stage label + real placement counter */}
              <div
                className={`flex w-full max-w-md flex-col gap-1.5 ${
                  shortLandscape ? "items-start" : "items-center"
                }`}
              >
                <div className="h-px w-full overflow-hidden bg-white/[0.14]">
                  <div
                    className="h-full origin-left bg-gradient-to-r from-[#22D3EE] to-[#8B5CF6] transition-transform duration-300 ease-out"
                    style={{ transform: `scaleX(${Math.max(0.03, state.progress)})` }}
                  />
                </div>

                <div className="flex w-full items-center justify-between gap-3 font-mono text-[10px] uppercase tracking-[0.16em] text-[#CBD5E1] tabular-nums">
                  <span>{state.stageLabel}</span>
                  {counterText ? <span className="text-[#22D3EE]">{counterText}</span> : null}
                </div>
              </div>

              <p className="nx-intro-disclaimer text-[11px] tracking-[0.02em] text-[#94A3B8]">
                {INTRO_DISCLAIMER}
              </p>
            </div>
          </div>
        </div>
      </div>
    </>
  );
}
</file>

<file path="src/features/landing/intro/introMachine.ts">
/**
 * Pure deterministic state machine and timing rules for the "First Light" landing intro loader.
 * No DOM or React dependencies so every transition and timing edge case is unit-testable.
 */
import { IGNITION_ORDER } from "./silhouetteData";

export type IntroPhase = "idle" | "loading" | "ready" | "exiting" | "done" | "skipped";
export type IntroStage = "chunk" | "geometry" | "shaders" | "firstFrame";

export const INTRO_SESSION_KEY = "ns:intro:v1";

export const INTRO_TIMING = {
  fastSkipMs: 400,
  minVisibleMs: 2600,
  skipButtonDelayMs: 2500,
  hardTimeoutMs: 12000,
  skipFadeMs: 320,
  exitDurationMs: 1250,
  exitReducedMs: 250,
  headlineRevealRatio: 0.6,
} as const;

export const STAGE_WEIGHTS: Record<IntroStage, { base: number; weight: number; label: string }> = {
  chunk: { base: 0, weight: 0.25, label: "LOADING THE OBSERVATORY" },
  geometry: { base: 0.25, weight: 0.35, label: "PLACING PARTICLES" },
  shaders: { base: 0.6, weight: 0.25, label: "COMPILING SHADERS" },
  firstFrame: { base: 0.85, weight: 0.15, label: "FIRST LIGHT" },
};

export interface IntroMachineState {
  phase: IntroPhase;
  variant: "full" | "minimal";
  mountedAtMs: number;
  loadingShownAtMs: number | null;
  exitingStartedAtMs: number | null;
  progress: number;
  stage: IntroStage;
  stageLabel: string;
  pointsPlaced: number | null;
  pointsTotal: number | null;
  ignitedCount: number;
  activeRegionIndex: number | null;
  brainReady: boolean;
  fontsReady: boolean;
  webglSupported: boolean;
  reducedMotion: boolean;
  canSkip: boolean;
  timedOut: boolean;
  shouldPersistSeen: boolean;
  headlineReleased: boolean;
  overlayMounted: boolean;
}

export type IntroEvent =
  | {
      type: "PROGRESS";
      stage: IntroStage;
      value: number;
      pointsPlaced?: number;
      pointsTotal?: number;
      nowMs?: number;
    }
  | { type: "BRAIN_READY"; nowMs: number }
  | { type: "FONTS_READY"; nowMs: number }
  | { type: "WEBGL_UNSUPPORTED"; nowMs: number }
  | { type: "TICK"; nowMs: number }
  | { type: "SKIP"; nowMs: number }
  | { type: "SET_SESSION_SEEN"; seen: boolean; nowMs: number }
  | { type: "REDUCED_MOTION_CHANGE"; reducedMotion: boolean };

function clamp01(v: number): number {
  if (!Number.isFinite(v)) return 0;
  return Math.min(1, Math.max(0, v));
}

export function getExitDurationMs(state: Pick<IntroMachineState, "reducedMotion" | "variant">): number {
  return state.reducedMotion || state.variant === "minimal"
    ? INTRO_TIMING.exitReducedMs
    : INTRO_TIMING.exitDurationMs;
}

export function computeMonotonicStageProgress(
  prevProgress: number,
  prevStage: IntroStage,
  stage: IntroStage,
  value: number,
): { progress: number; stage: IntroStage; stageLabel: string } {
  const spec = STAGE_WEIGHTS[stage];
  const candidate = clamp01(spec.base + spec.weight * clamp01(value));
  const progress = Math.max(prevProgress, candidate);
  const nextStage = STAGE_WEIGHTS[stage].base >= STAGE_WEIGHTS[prevStage].base ? stage : prevStage;
  const stageLabel =
    progress >= 0.999 ? STAGE_WEIGHTS.firstFrame.label : STAGE_WEIGHTS[nextStage].label;
  return { progress, stage: nextStage, stageLabel };
}

function computeIgnitionForProgress(
  phase: IntroPhase,
  progress: number,
  loadingElapsedMs: number,
  reducedMotion: boolean,
): { ignitedCount: number; activeRegionIndex: number | null } {
  const totalRegions = IGNITION_ORDER.length;
  if (phase === "exiting" || phase === "done") {
    return { ignitedCount: totalRegions, activeRegionIndex: totalRegions - 1 };
  }
  if (phase !== "loading" && phase !== "ready") {
    return { ignitedCount: 0, activeRegionIndex: null };
  }
  if (reducedMotion) {
    return { ignitedCount: totalRegions, activeRegionIndex: totalRegions - 1 };
  }

  // Spread ignition gently across the minimum visible duration so every region caption is readable,
  // even after WebGL finishes early and holds in "ready".
  const pacedFrac = clamp01((loadingElapsedMs + 140) / (INTRO_TIMING.minVisibleMs * 0.92));
  const progressFrac = clamp01((progress * 0.85) / 0.94);
  const combined = phase === "ready" ? pacedFrac : 0.78 * pacedFrac + 0.22 * progressFrac;
  const ignited = Math.max(1, Math.min(totalRegions, Math.ceil(combined * totalRegions)));
  return {
    ignitedCount: ignited,
    activeRegionIndex: Math.min(totalRegions - 1, ignited - 1),
  };
}

export interface CreateIntroStateOptions {
  mountedAtMs?: number;
  seenInSession?: boolean;
  reducedMotion?: boolean;
  webglSupported?: boolean;
  fontsReady?: boolean;
}

export function createIntroState(options: CreateIntroStateOptions = {}): IntroMachineState {
  const {
    mountedAtMs = 0,
    seenInSession = false,
    reducedMotion = false,
    webglSupported = true,
    fontsReady = false,
  } = options;

  if (!webglSupported) {
    return {
      phase: "skipped",
      variant: seenInSession ? "minimal" : "full",
      mountedAtMs,
      loadingShownAtMs: null,
      exitingStartedAtMs: mountedAtMs,
      progress: 1,
      stage: "firstFrame",
      stageLabel: STAGE_WEIGHTS.firstFrame.label,
      pointsPlaced: null,
      pointsTotal: null,
      ignitedCount: 0,
      activeRegionIndex: null,
      brainReady: false,
      fontsReady,
      webglSupported: false,
      reducedMotion,
      canSkip: false,
      timedOut: false,
      shouldPersistSeen: false,
      headlineReleased: true,
      overlayMounted: false,
    };
  }

  return {
    phase: "idle",
    variant: seenInSession ? "minimal" : "full",
    mountedAtMs,
    loadingShownAtMs: null,
    exitingStartedAtMs: null,
    progress: 0,
    stage: "chunk",
    stageLabel: STAGE_WEIGHTS.chunk.label,
    pointsPlaced: null,
    pointsTotal: null,
    ignitedCount: 0,
    activeRegionIndex: null,
    brainReady: false,
    fontsReady,
    webglSupported: true,
    reducedMotion,
    canSkip: false,
    timedOut: false,
    shouldPersistSeen: false,
    headlineReleased: false,
    overlayMounted: true,
  };
}

function finalizeReadyState(state: IntroMachineState, nowMs: number): IntroMachineState {
  const isAllReady = state.brainReady && state.fontsReady;
  if (!isAllReady) return state;

  const elapsed = Math.max(0, nowMs - state.mountedAtMs);

  // Fast skip rule: ready before the 400ms threshold -> never flash full loader.
  if (state.phase === "idle" && elapsed < INTRO_TIMING.fastSkipMs) {
    return {
      ...state,
      phase: "done",
      progress: 1,
      stage: "firstFrame",
      stageLabel: STAGE_WEIGHTS.firstFrame.label,
      ignitedCount: IGNITION_ORDER.length,
      activeRegionIndex: IGNITION_ORDER.length - 1,
      headlineReleased: true,
      overlayMounted: false,
    };
  }

  if (state.phase === "idle" && state.variant === "minimal") {
    return {
      ...state,
      phase: "exiting",
      exitingStartedAtMs: nowMs,
      progress: 1,
      stage: "firstFrame",
      stageLabel: STAGE_WEIGHTS.firstFrame.label,
      headlineReleased: true,
    };
  }

  if (state.phase === "idle" || state.phase === "loading") {
    const shownAt = state.loadingShownAtMs ?? state.mountedAtMs;
    const minVisibleElapsed = nowMs - shownAt;
    if (minVisibleElapsed >= INTRO_TIMING.minVisibleMs) {
      return {
        ...state,
        phase: "exiting",
        exitingStartedAtMs: nowMs,
        progress: 1,
        stage: "firstFrame",
        stageLabel: STAGE_WEIGHTS.firstFrame.label,
        ignitedCount: IGNITION_ORDER.length,
        activeRegionIndex: IGNITION_ORDER.length - 1,
        shouldPersistSeen: true,
        headlineReleased: state.reducedMotion,
      };
    }
    const ign = computeIgnitionForProgress(
      "ready",
      1,
      Math.max(0, minVisibleElapsed),
      state.reducedMotion,
    );
    return {
      ...state,
      phase: "ready",
      progress: 1,
      stage: "firstFrame",
      stageLabel: STAGE_WEIGHTS.firstFrame.label,
      ignitedCount: Math.max(state.ignitedCount, ign.ignitedCount),
      activeRegionIndex: Math.max(state.activeRegionIndex ?? 0, ign.activeRegionIndex ?? 0),
    };
  }

  return state;
}

export function transitionIntro(state: IntroMachineState, event: IntroEvent): IntroMachineState {
  if (event.type === "SET_SESSION_SEEN") {
    if (!event.seen || state.variant === "minimal") return state;
    const next: IntroMachineState = { ...state, variant: "minimal" };
    if (next.phase === "loading") {
      return { ...next, phase: "idle" };
    }
    return next.brainReady && next.fontsReady ? finalizeReadyState(next, event.nowMs) : next;
  }

  if (event.type === "REDUCED_MOTION_CHANGE") {
    if (state.reducedMotion === event.reducedMotion) return state;
    const next = { ...state, reducedMotion: event.reducedMotion };
    if (next.phase === "loading") {
      const loadingElapsed = next.loadingShownAtMs !== null ? Math.max(0, 0) : 0;
      const ign = computeIgnitionForProgress(next.phase, next.progress, loadingElapsed, next.reducedMotion);
      return { ...next, ...ign };
    }
    return next;
  }

  if (event.type === "WEBGL_UNSUPPORTED") {
    if (state.phase === "done") return state;
    return {
      ...state,
      phase: "skipped",
      webglSupported: false,
      exitingStartedAtMs: event.nowMs,
      headlineReleased: true,
      overlayMounted: false,
    };
  }

  if (state.phase === "done") {
    return state;
  }

  if (state.phase === "skipped") {
    if (event.type !== "TICK") return state;
    if (!state.overlayMounted) return state;
    const fadeStart = state.exitingStartedAtMs ?? event.nowMs;
    if (event.nowMs - fadeStart >= INTRO_TIMING.skipFadeMs) {
      return { ...state, overlayMounted: false };
    }
    return state;
  }

  if (event.type === "SKIP") {
    return {
      ...state,
      phase: "skipped",
      exitingStartedAtMs: event.nowMs,
      canSkip: true,
      shouldPersistSeen: true,
      headlineReleased: true,
    };
  }

  if (event.type === "PROGRESS") {
    const mono = computeMonotonicStageProgress(
      state.progress,
      state.stage,
      event.stage,
      event.value,
    );
    const pointsPlaced =
      typeof event.pointsPlaced === "number" ? event.pointsPlaced : state.pointsPlaced;
    const pointsTotal =
      typeof event.pointsTotal === "number" ? event.pointsTotal : state.pointsTotal;
    const loadingElapsed =
      state.loadingShownAtMs !== null && typeof event.nowMs === "number"
        ? Math.max(0, event.nowMs - state.loadingShownAtMs)
        : 0;
    const ign = computeIgnitionForProgress(
      state.phase,
      mono.progress,
      loadingElapsed,
      state.reducedMotion,
    );
    return {
      ...state,
      progress: mono.progress,
      stage: mono.stage,
      stageLabel: mono.stageLabel,
      pointsPlaced,
      pointsTotal,
      ...ign,
    };
  }

  if (event.type === "BRAIN_READY") {
    return finalizeReadyState({ ...state, brainReady: true }, event.nowMs);
  }

  if (event.type === "FONTS_READY") {
    return finalizeReadyState({ ...state, fontsReady: true }, event.nowMs);
  }

  // event.type === "TICK"
  const nowMs = event.nowMs;
  const elapsed = Math.max(0, nowMs - state.mountedAtMs);
  const canSkip =
    state.canSkip || (elapsed >= INTRO_TIMING.skipButtonDelayMs && (state.phase === "idle" || state.phase === "loading" || state.phase === "ready"));

  // Exiting timeline progression
  if (state.phase === "exiting") {
    const exitStart = state.exitingStartedAtMs ?? nowMs;
    const exitDur = getExitDurationMs(state);
    const exitElapsed = Math.max(0, nowMs - exitStart);
    const ratio = exitDur > 0 ? exitElapsed / exitDur : 1;
    const headlineReleased =
      state.headlineReleased || ratio >= INTRO_TIMING.headlineRevealRatio;

    if (exitElapsed >= exitDur) {
      return {
        ...state,
        phase: "done",
        progress: 1,
        shouldPersistSeen: true,
        headlineReleased: true,
        overlayMounted: false,
      };
    }

    return headlineReleased !== state.headlineReleased
      ? { ...state, headlineReleased }
      : state;
  }

  // Hard timeout after 12 seconds -> hand off gracefully even if still loading.
  if (elapsed >= INTRO_TIMING.hardTimeoutMs) {
    return {
      ...state,
      phase: "exiting",
      exitingStartedAtMs: nowMs,
      timedOut: true,
      canSkip,
      shouldPersistSeen: true,
      headlineReleased: state.variant === "minimal" || state.reducedMotion,
    };
  }

  // Transition idle -> loading after the 400ms fast-skip window (only for full variant).
  if (state.phase === "idle") {
    if (state.brainReady && state.fontsReady) {
      return finalizeReadyState({ ...state, canSkip }, nowMs);
    }
    if (state.variant === "full" && elapsed >= INTRO_TIMING.fastSkipMs) {
      const loadingShownAtMs = nowMs;
      const ign = computeIgnitionForProgress("loading", state.progress, 0, state.reducedMotion);
      return {
        ...state,
        phase: "loading",
        loadingShownAtMs,
        canSkip,
        ...ign,
      };
    }
    return canSkip !== state.canSkip ? { ...state, canSkip } : state;
  }

  if (state.phase === "loading") {
    const shownAt = state.loadingShownAtMs ?? nowMs;
    const loadingElapsed = Math.max(0, nowMs - shownAt);
    const ign = computeIgnitionForProgress(
      "loading",
      state.progress,
      loadingElapsed,
      state.reducedMotion,
    );
    const updated: IntroMachineState = { ...state, canSkip, ...ign };
    if (updated.brainReady && updated.fontsReady) {
      return finalizeReadyState(updated, nowMs);
    }
    return updated;
  }

  if (state.phase === "ready") {
    const shownAt = state.loadingShownAtMs ?? state.mountedAtMs;
    const readyElapsed = Math.max(0, nowMs - shownAt);
    if (readyElapsed >= INTRO_TIMING.minVisibleMs) {
      return {
        ...state,
        phase: "exiting",
        exitingStartedAtMs: nowMs,
        canSkip,
        ignitedCount: IGNITION_ORDER.length,
        activeRegionIndex: IGNITION_ORDER.length - 1,
        shouldPersistSeen: true,
        headlineReleased: state.reducedMotion,
      };
    }
    const ign = computeIgnitionForProgress("ready", 1, readyElapsed, state.reducedMotion);
    const ignitedCount = Math.max(state.ignitedCount, ign.ignitedCount);
    const activeRegionIndex = Math.max(state.activeRegionIndex ?? 0, ign.activeRegionIndex ?? 0);
    if (
      canSkip !== state.canSkip ||
      ignitedCount !== state.ignitedCount ||
      activeRegionIndex !== state.activeRegionIndex
    ) {
      return { ...state, canSkip, ignitedCount, activeRegionIndex };
    }
    return state;
  }

  return state;
}

export function readSessionIntroSeen(): boolean {
  if (typeof window === "undefined") return false;
  try {
    return (
      window.document?.documentElement?.dataset?.intro === "seen" ||
      window.sessionStorage.getItem(INTRO_SESSION_KEY) === "1"
    );
  } catch {
    return false;
  }
}

export function writeSessionIntroSeen(): void {
  if (typeof window === "undefined") return;
  try {
    window.sessionStorage.setItem(INTRO_SESSION_KEY, "1");
    window.document?.documentElement?.setAttribute("data-intro", "seen");
  } catch {
    // ignore storage quota / privacy mode failures
  }
}
