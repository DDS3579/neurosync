    expect(readBrainImmersivePref()).toBe(true);
    expect(readBrainSizePref()).toBe(1.0);
    expect(() => writeBrainImmersivePref(false)).not.toThrow();
    expect(writeBrainSizePref(1.5)).toBe(1.5);
