import { afterEach, describe, expect, it, vi } from "vitest";

import {
  DEFAULT_BRAIN_IMMERSIVE,
  DEFAULT_BRAIN_SIZE,
  UI_BRAIN_IMMERSIVE_KEY,
  UI_BRAIN_SIZE_KEY,
  readBrainImmersivePref,
  readBrainSizePref,
  writeBrainImmersivePref,
  writeBrainSizePref,
