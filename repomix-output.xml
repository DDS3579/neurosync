    const out30 = computeInsights(demo30, TODAY);
    expect(out14.length).toBeGreaterThan(0);
    expect(out30.length).toBeGreaterThan(0);
    expect(new Set(out30.map((i) => i.id)).size).toBe(out30.length);
  });
});

