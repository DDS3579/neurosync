"use client";

import { create } from "zustand";

import {
  PANEL_LAYOUT_SCHEMA_VERSION,
  clampPanelPosition,
  createEmptyPanelLayout,
  readPersistedPanelLayout,
  writePersistedPanelLayout,
  type PanelPosition,
  type PanelSize,
  type PanelState,
  type PersistedPanelLayout,
  type ViewportSize,
} from "./panelLayout";

export interface PanelDefaultsSpec {
  id: string;
  defaultPosition: PanelPosition;
  defaultSize?: PanelSize;
  defaultCollapsed?: boolean | ((viewport: ViewportSize) => boolean);
  resolveDefaultPosition?: (
    viewport: ViewportSize,
    size: { width: number; height: number },
  ) => PanelPosition;
}

function resolveCollapsedDefault(
  defaultCollapsed: PanelDefaultsSpec["defaultCollapsed"],
  viewport?: ViewportSize,
): boolean {
  if (typeof defaultCollapsed === "function") {
    return viewport ? defaultCollapsed(viewport) : false;
  }
  return Boolean(defaultCollapsed);
}

interface PanelLayoutStoreState {
  hydrated: boolean;
  topZ: number;
  panels: Record<string, PanelState>;
  defaults: Record<string, PanelDefaultsSpec>;
  measuredSizes: Record<string, { width: number; height: number }>;
  activeMobilePanelId: string | null;

  hydrateFromStorage: () => void;
  registerPanel: (spec: PanelDefaultsSpec, viewport?: ViewportSize) => void;
  setMeasuredSize: (id: string, size: { width: number; height: number }) => void;
  setPosition: (id: string, pos: PanelPosition) => void;
  setSize: (id: string, size: { width: number; height?: number }) => void;
  setCollapsed: (id: string, collapsed: boolean, viewport?: ViewportSize) => void;
  toggleCollapsed: (id: string, viewport?: ViewportSize) => void;
  setClosed: (id: string, closed: boolean) => void;
  bringToFront: (id: string) => void;
  clampAllToViewport: (viewport: ViewportSize) => void;
  setMobileActivePanel: (id: string | null) => void;
  resetLayout: (viewport?: ViewportSize) => void;
}

function persistSnapshot(topZ: number, panels: Record<string, PanelState>): void {
  const payload: PersistedPanelLayout = {
    version: PANEL_LAYOUT_SCHEMA_VERSION,
    topZ,
    panels,
  };
  writePersistedPanelLayout(payload);
}

function getEffectiveSize(
  id: string,
  panel: PanelState | undefined,
  defaults: Record<string, PanelDefaultsSpec>,
  measured: Record<string, { width: number; height: number }>,
  collapsedOverride?: boolean,
): { width: number; height: number } {
  const isCollapsed = collapsedOverride ?? Boolean(panel?.collapsed);
  if (isCollapsed) {
    return { width: 180, height: 38 };
  }
  const measuredSize = measured[id];
  if (measuredSize && measuredSize.width > 0 && measuredSize.height > 0) {
    return measuredSize;
  }
  const def = defaults[id]?.defaultSize;
  return {
    width: panel?.width ?? def?.width ?? 300,
    height: panel?.height ?? def?.height ?? 240,
  };
}

export const usePanelLayout = create<PanelLayoutStoreState>((set, get) => ({
  hydrated: false,
  topZ: 1,
  panels: {},
  defaults: {},
  measuredSizes: {},
  activeMobilePanelId: null,

  hydrateFromStorage: () => {
    if (get().hydrated) return;
    const loaded = readPersistedPanelLayout();
    set((state) => {
      const mergedPanels: Record<string, PanelState> = { ...loaded.panels };
      let nextTopZ = loaded.topZ;

      for (const [id, spec] of Object.entries(state.defaults)) {
        if (!mergedPanels[id]) {
          nextTopZ += 1;
          const size = {
            width: spec.defaultSize?.width ?? 300,
            height: spec.defaultSize?.height ?? 240,
          };
          const viewport =
            typeof window !== "undefined"
              ? { width: window.innerWidth, height: window.innerHeight }
              : undefined;
          const resolvedPos =
            viewport && spec.resolveDefaultPosition
              ? spec.resolveDefaultPosition(viewport, size)
              : spec.defaultPosition;
          mergedPanels[id] = {
            x: resolvedPos.x,
            y: resolvedPos.y,
            ...(spec.defaultSize?.width !== undefined ? { width: spec.defaultSize.width } : {}),
            ...(spec.defaultSize?.height !== undefined ? { height: spec.defaultSize.height } : {}),
            collapsed: resolveCollapsedDefault(spec.defaultCollapsed, viewport),
            closed: false,
            zIndex: nextTopZ,
          };
        }
      }

      return {
        hydrated: true,
        topZ: nextTopZ,
        panels: mergedPanels,
      };
    });
  },

  registerPanel: (spec, viewport) => {
    set((state) => {
      const nextDefaults = { ...state.defaults, [spec.id]: spec };
      const existing = state.panels[spec.id];

      if (existing) {
        if (!viewport) {
          return { defaults: nextDefaults };
        }
        const size = getEffectiveSize(spec.id, existing, nextDefaults, state.measuredSizes);
        const clamped = clampPanelPosition(existing, size, viewport);
        if (clamped.x === existing.x && clamped.y === existing.y) {
          return { defaults: nextDefaults };
        }
        const nextPanels = {
          ...state.panels,
          [spec.id]: { ...existing, x: clamped.x, y: clamped.y },
        };
        if (state.hydrated) persistSnapshot(state.topZ, nextPanels);
        return { defaults: nextDefaults, panels: nextPanels };
      }

      const nextTopZ = state.topZ + 1;
      const estimatedSize = {
        width: spec.defaultSize?.width ?? 300,
        height: spec.defaultSize?.height ?? 240,
      };
      const rawDefaultPos =
        viewport && spec.resolveDefaultPosition
          ? spec.resolveDefaultPosition(viewport, estimatedSize)
          : spec.defaultPosition;
      const basePos = viewport
        ? clampPanelPosition(rawDefaultPos, estimatedSize, viewport)
        : rawDefaultPos;

      const nextPanels: Record<string, PanelState> = {
        ...state.panels,
        [spec.id]: {
          x: basePos.x,
          y: basePos.y,
          ...(spec.defaultSize?.width !== undefined ? { width: spec.defaultSize.width } : {}),
          ...(spec.defaultSize?.height !== undefined ? { height: spec.defaultSize.height } : {}),
          collapsed: resolveCollapsedDefault(spec.defaultCollapsed, viewport),
          closed: false,
          zIndex: nextTopZ,
        },
      };

      if (state.hydrated) persistSnapshot(nextTopZ, nextPanels);
      return {
        defaults: nextDefaults,
        topZ: nextTopZ,
        panels: nextPanels,
      };
    });
  },

  setMeasuredSize: (id, size) => {
    set((state) => {
      const prev = state.measuredSizes[id];
      const nextMeasured = {
        ...state.measuredSizes,
        [id]: size,
      };
      const currentPanel = state.panels[id];
      const viewport =
        typeof window !== "undefined"
          ? { width: window.innerWidth, height: window.innerHeight }
          : null;

      let nextPanels = state.panels;
      if (currentPanel && viewport) {
        const clamped = clampPanelPosition(currentPanel, size, viewport);
        if (clamped.x !== currentPanel.x || clamped.y !== currentPanel.y) {
          nextPanels = {
            ...state.panels,
            [id]: { ...currentPanel, x: clamped.x, y: clamped.y },
          };
          if (state.hydrated) persistSnapshot(state.topZ, nextPanels);
        }
      }

      if (
        prev &&
        prev.width === size.width &&
        prev.height === size.height &&
        nextPanels === state.panels
      ) {
        return state;
      }

      return {
        measuredSizes: nextMeasured,
        ...(nextPanels !== state.panels ? { panels: nextPanels } : {}),
      };
    });
  },

  setPosition: (id, pos) => {
    set((state) => {
      const current = state.panels[id];
      if (!current) return state;
      if (current.x === pos.x && current.y === pos.y) return state;
      const nextPanels = {
        ...state.panels,
        [id]: { ...current, x: Math.round(pos.x), y: Math.round(pos.y) },
      };
      if (state.hydrated) persistSnapshot(state.topZ, nextPanels);
      return { panels: nextPanels };
    });
  },

  setSize: (id, size) => {
    set((state) => {
      const current = state.panels[id];
      if (!current) return state;
      const nextPanels = {
        ...state.panels,
        [id]: {
          ...current,
          width: Math.round(size.width),
          ...(size.height !== undefined ? { height: Math.round(size.height) } : {}),
        },
      };
      if (state.hydrated) persistSnapshot(state.topZ, nextPanels);
      return { panels: nextPanels };
    });
  },

  setCollapsed: (id, collapsed, viewport) => {
    set((state) => {
      const current = state.panels[id];
      if (!current) return state;
      let nextX = current.x;
      let nextY = current.y;
      if (viewport) {
        const size = getEffectiveSize(id, current, state.defaults, state.measuredSizes);
        const clamped = clampPanelPosition({ x: nextX, y: nextY }, size, viewport);
        nextX = clamped.x;
        nextY = clamped.y;
      }
      const nextPanels = {
        ...state.panels,
        [id]: { ...current, collapsed, x: nextX, y: nextY },
      };
      if (state.hydrated) persistSnapshot(state.topZ, nextPanels);
      return { panels: nextPanels };
    });
  },

  toggleCollapsed: (id, viewport) => {
    const current = get().panels[id];
    if (!current) return;
    get().setCollapsed(id, !current.collapsed, viewport);
  },

  setClosed: (id, closed) => {
    set((state) => {
      const current = state.panels[id];
      if (!current) return state;
      const nextPanels = {
        ...state.panels,
        [id]: { ...current, closed },
      };
      if (state.hydrated) persistSnapshot(state.topZ, nextPanels);
      return {
        panels: nextPanels,
        activeMobilePanelId:
          closed && state.activeMobilePanelId === id ? null : state.activeMobilePanelId,
      };
    });
  },

  bringToFront: (id) => {
    set((state) => {
      const current = state.panels[id];
      if (!current) return state;
      if (current.zIndex === state.topZ) return state;
      const nextTopZ = state.topZ + 1;
      const nextPanels = {
        ...state.panels,
        [id]: { ...current, zIndex: nextTopZ },
      };
      if (state.hydrated) persistSnapshot(nextTopZ, nextPanels);
      return { topZ: nextTopZ, panels: nextPanels };
    });
  },

  clampAllToViewport: (viewport) => {
    set((state) => {
      let changed = false;
      const nextPanels: Record<string, PanelState> = { ...state.panels };
      const narrowDesktop = viewport.width >= 768 && viewport.width < 920;

      for (const [id, panel] of Object.entries(state.panels)) {
        const shouldAutoCollapse = narrowDesktop && !panel.collapsed;
        const size = getEffectiveSize(
          id,
          panel,
          state.defaults,
          state.measuredSizes,
          shouldAutoCollapse || panel.collapsed,
        );
        const clamped = clampPanelPosition(panel, size, viewport);

        if (clamped.x !== panel.x || clamped.y !== panel.y || shouldAutoCollapse) {
          nextPanels[id] = {
            ...panel,
            x: clamped.x,
            y: clamped.y,
            ...(shouldAutoCollapse ? { collapsed: true } : {}),
          };
          changed = true;
        }
      }

      if (!changed) return state;
      if (state.hydrated) persistSnapshot(state.topZ, nextPanels);
      return { panels: nextPanels };
    });
  },

  setMobileActivePanel: (id) => {
    set({ activeMobilePanelId: id });
  },

  resetLayout: (viewport) => {
    set((state) => {
      const nextPanels: Record<string, PanelState> = {};
      let nextTopZ = 1;

      for (const [id, spec] of Object.entries(state.defaults)) {
        nextTopZ += 1;
        const estimatedSize = {
          width: spec.defaultSize?.width ?? 300,
          height: spec.defaultSize?.height ?? 240,
        };
        const rawPos =
          viewport && spec.resolveDefaultPosition
            ? spec.resolveDefaultPosition(viewport, estimatedSize)
            : spec.defaultPosition;
        const pos = viewport
          ? clampPanelPosition(rawPos, estimatedSize, viewport)
          : rawPos;

        nextPanels[id] = {
          x: pos.x,
          y: pos.y,
          ...(spec.defaultSize?.width !== undefined ? { width: spec.defaultSize.width } : {}),
          ...(spec.defaultSize?.height !== undefined ? { height: spec.defaultSize.height } : {}),
          collapsed: resolveCollapsedDefault(spec.defaultCollapsed, viewport),
          closed: false,
          zIndex: nextTopZ,
        };
      }

      const fallback = createEmptyPanelLayout();
      persistSnapshot(Math.max(nextTopZ, fallback.topZ), nextPanels);
      return {
        topZ: Math.max(nextTopZ, fallback.topZ),
        panels: nextPanels,
        activeMobilePanelId: null,
      };
    });
  },
}));

/**
 * Restores all registered floating panels to their default positions and states.
 */
export function resetPanelLayout(viewport?: ViewportSize): void {
  const effectiveViewport =
    viewport ??
    (typeof window !== "undefined"
      ? { width: window.innerWidth, height: window.innerHeight }
      : undefined);
  usePanelLayout.getState().resetLayout(effectiveViewport);
}
</file>

<file path="src/features/brain/components/BrainImmersivePanels.tsx">
"use client";

import type { ReactNode } from "react";
import Link from "next/link";
import { usePathname } from "next/navigation";
import {
  Activity,
  Brain,
  Clock,
  Command as CommandIcon,
  Compass,
  LayoutGrid,
  Minimize2,
  PlusCircle,
  SlidersHorizontal,
} from "lucide-react";

import { ALL_NAV_ITEMS, isActiveRoute } from "@/components/app-shell/nav-items";
import { FloatingPanel, FloatingPanelLayer, resetPanelLayout } from "@/components/floating";
import { Button } from "@/components/ui/button";
import { cn } from "@/lib/utils";

export interface BrainImmersivePanelsProps {
  onExitImmersive: () => void;
  onOpenCommandPalette: () => void;
  modeContent: ReactNode;
  regionContent: ReactNode;
  impactContent: ReactNode;
  timelineContent: ReactNode;
  quickLogContent?: ReactNode;
}

/**
 * Immersive /brain floating workspace:
 * - Navigation Dock (top-left, collapsed to icons by default)
 * - Quick Log (top-left under dock, collapsed by default)
 * - Modes & Controls (bottom-left on desktop, collapsed <1024px)
 * - Time Scrubber (bottom-center, slim, collapsible)
 * - Region Details (top-right on desktop, collapsed <1024px)
 * - Activity Impact (bottom-right on desktop, collapsed <1024px)
 * On mobile (<768px), FloatingPanelLayer renders them as a bottom chip row + single-open sheet.
 */
export function BrainImmersivePanels({
  onExitImmersive,
  onOpenCommandPalette,
  modeContent,
  regionContent,
  impactContent,
  timelineContent,
  quickLogContent,
}: BrainImmersivePanelsProps) {
  const pathname = usePathname();

  const collapsedNavIcons = (
    <nav aria-label="Quick navigation" className="flex items-center gap-0.5">
      {ALL_NAV_ITEMS.map((item) => {
        const Icon = item.icon;
        const active = isActiveRoute(pathname, item.href);
        return (
          <Link
            key={item.href}
            href={item.href}
            data-panel-action="true"
            aria-label={item.label}
            aria-current={active ? "page" : undefined}
            title={item.label}
            className={cn(
              "inline-flex size-7 items-center justify-center rounded-full transition-colors focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none",
              active
                ? "bg-violet/25 text-violet-text ring-1 ring-violet/50"
                : "text-muted-foreground hover:bg-white/[0.06] hover:text-foreground",
            )}
          >
            <Icon className="size-3.5" aria-hidden />
          </Link>
        );
      })}
      <span aria-hidden className="mx-0.5 h-4 w-px bg-border" />
      <button
        type="button"
        data-panel-action="true"
        onClick={onOpenCommandPalette}
        aria-label="Open command palette (Ctrl+K)"
        title="Command palette (Ctrl/⌘+K)"
        className="inline-flex size-7 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-white/[0.06] hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
      >
        <CommandIcon className="size-3.5" aria-hidden />
      </button>
      <button
        type="button"
        data-panel-action="true"
        onClick={onExitImmersive}
        aria-label="Exit immersive mode"
        title="Exit immersive (Esc)"
        className="inline-flex size-7 items-center justify-center rounded-full text-cyan transition-colors hover:bg-white/[0.06] focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
      >
        <Minimize2 className="size-3.5" aria-hidden />
      </button>
    </nav>
  );

  return (
    <FloatingPanelLayer>
      <FloatingPanel
        id="brain-nav-dock"
        title="Navigation"
        chipLabel="Nav"
        icon={<Compass className="size-3.5" aria-hidden />}
        defaultPosition={{ x: 16, y: 16 }}
        defaultSize={{ width: 248 }}
        defaultCollapsed
        collapsedContent={collapsedNavIcons}
      >
        <div className="space-y-3">
          <nav aria-label="Brain Explorer navigation" className="space-y-1">
            {ALL_NAV_ITEMS.map((item) => {
              const Icon = item.icon;
              const active = isActiveRoute(pathname, item.href);
              return (
                <Link
                  key={item.href}
                  href={item.href}
                  aria-current={active ? "page" : undefined}
                  className={cn(
                    "flex items-center gap-2.5 rounded-control px-2.5 py-1.5 text-caption transition-colors focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none",
                    active
                      ? "bg-violet/20 font-medium text-violet-text ring-1 ring-violet/40"
                      : "text-muted-foreground hover:bg-white/[0.05] hover:text-foreground",
                  )}
                >
                  <Icon className="size-4 shrink-0" aria-hidden />
                  <span className="truncate">{item.label}</span>
                </Link>
              );
            })}
          </nav>

          <div className="space-y-1.5 border-t border-border pt-2.5">
            <Button
              type="button"
              size="sm"
              variant="outline"
              onClick={onOpenCommandPalette}
              className="w-full justify-between rounded-control text-caption"
            >
              <span className="inline-flex items-center gap-1.5">
                <CommandIcon className="size-3.5 text-cyan" aria-hidden />
                Command palette
              </span>
              <kbd className="rounded bg-surface-2 px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
                Ctrl+K
              </kbd>
            </Button>

            <div className="grid grid-cols-2 gap-1.5">
              <Button
                type="button"
                size="sm"
                variant="outline"
                onClick={() => resetPanelLayout()}
                className="gap-1 rounded-control px-2 text-caption"
              >
                <LayoutGrid className="size-3.5 text-muted-foreground" aria-hidden />
                Reset layout
              </Button>
              <Button
                type="button"
                size="sm"
                variant="outline"
                onClick={onExitImmersive}
                aria-label="Exit immersive mode"
                className="gap-1 rounded-control px-2 text-caption"
              >
                <Minimize2 className="size-3.5 text-cyan" aria-hidden />
                Exit
              </Button>
            </div>
          </div>
        </div>
      </FloatingPanel>

      {quickLogContent ? (
        <FloatingPanel
          id="brain-quick-log"
          title="Quick Log"
          chipLabel="Log"
          icon={<PlusCircle className="size-3.5" aria-hidden />}
          defaultPosition={{ x: 16, y: 72 }}
          defaultSize={{ width: 312 }}
          defaultCollapsed
        >
          {quickLogContent}
        </FloatingPanel>
      ) : null}

      <FloatingPanel
        id="brain-mode-panel"
        title="Modes & Controls"
        chipLabel="Modes"
        icon={<SlidersHorizontal className="size-3.5" aria-hidden />}
        defaultPosition={{ x: 16, y: 460 }}
        resolveDefaultPosition={(vp, size) => ({
          x: 16,
          y: Math.max(120, vp.height - Math.max(size.height, 360) - 16),
        })}
        defaultSize={{ width: 332 }}
        defaultCollapsed={(vp) => vp.width < 1024}
        resizable
      >
        {modeContent}
      </FloatingPanel>

      <FloatingPanel
        id="brain-time-scrubber"
        title="Timeline"
        chipLabel="Time"
        icon={<Clock className="size-3.5" aria-hidden />}
        defaultPosition={{ x: 460, y: 740 }}
        resolveDefaultPosition={(vp, size) => ({
          x: Math.max(16, Math.round((vp.width - size.width) / 2)),
          y: Math.max(16, vp.height - Math.max(size.height, 140) - 16),
        })}
        defaultSize={{ width: 396 }}
        defaultCollapsed={(vp) => vp.width < 1024}
      >
        {timelineContent}
      </FloatingPanel>

      <FloatingPanel
        id="brain-region-panel"
        title="Region Details"
        chipLabel="Region"
        icon={<Brain className="size-3.5" aria-hidden />}
        defaultPosition={{ x: 1068, y: 16 }}
        resolveDefaultPosition={(vp, size) => ({
          x: Math.max(16, vp.width - size.width - 16),
          y: 16,
        })}
        defaultSize={{ width: 356, height: 420 }}
        defaultCollapsed={(vp) => vp.width < 1024}
        resizable
      >
        {regionContent}
      </FloatingPanel>

      <FloatingPanel
        id="brain-impact-panel"
        title="Activity Impact"
        chipLabel="Impact"
        icon={<Activity className="size-3.5" aria-hidden />}
        defaultPosition={{ x: 1068, y: 540 }}
        resolveDefaultPosition={(vp, size) => ({
          x: Math.max(16, vp.width - size.width - 16),
          y: Math.max(16, vp.height - Math.max(size.height, 340) - 16),
        })}
        defaultSize={{ width: 356, height: 340 }}
        defaultCollapsed={(vp) => vp.width < 1024}
        resizable
      >
        {impactContent}
      </FloatingPanel>
    </FloatingPanelLayer>
  );
}
</file>

<file path="src/features/brain/BrainExplorer.tsx">
"use client";

import dynamic from "next/dynamic";
import { useEffect, useId, useMemo, type RefObject } from "react";

import { ACTIVITY_META, BRAIN_REGIONS } from "@/data/brainRegions";
import { cn } from "@/lib/utils";
import type { ActivityKind, RegionId } from "@/types/domain";
import { BrainFallback } from "./BrainFallback";
import type { BrainCameraAction } from "./BrainScene";
import { CUT_AXIS_DEFAULTS, type BrainMode, type CrossSectionConfig } from "./regionZones";
import {
  useBrainQuality,
  useBrainStage,
  useHighContrast,
  usePrefersReducedMotion,
  useTextSize,
  type QualityPref,
} from "./useBrainQuality";

/* ------------------------------------------------------------------ */
/* PUBLIC CONSTANTS & TYPES                                            */
/* ------------------------------------------------------------------ */
export const ACTIVITY_DISCLAIMER = "Educational association, not a measurement of your brain activity.";

export interface BrainExplorerProps {
  mode: BrainMode;
  selectedRegion: RegionId | null;
  activity: Partial<Record<RegionId, number>>; // 0..1, drives 'activity' mode
  activityRef?: RefObject<Partial<Record<RegionId, number>> | null>;
  onSelectRegion: (id: RegionId | null) => void;
  onHoverRegion?: (id: RegionId | null) => void;
  quality?: QualityPref;
  className?: string;
  isolated?: boolean;
  onExitIsolation?: () => void;
  compare?: { activityA: ActivityKind; activityB: ActivityKind } | null;
  crossSection?: CrossSectionConfig | null;
  focusRequestKey?: number;
  onGlbStatusChange?: (hasGlb: boolean) => void;
  brainSize?: number;
  cameraAction?: BrainCameraAction | null;
  srContextNote?: string;
}

const BrainExplorerCanvas = dynamic(
  () => import("./BrainScene").then((m) => m.BrainExplorerCanvas),
  {
    ssr: false,
    loading: () => (
      <div className="flex h-full w-full items-center justify-center bg-[#060913] text-xs text-muted-foreground">
        Initializing 3D atlas…
      </div>
    ),
  },
);

export function BrainExplorer({
  mode,
  selectedRegion,
  activity,
  activityRef,
  onSelectRegion,
  onHoverRegion,
  quality = "auto",
  className,
  isolated = false,
  onExitIsolation,
  compare = null,
  crossSection = null,
  focusRequestKey = 0,
  onGlbStatusChange,
  brainSize = 1,
  cameraAction = null,
  srContextNote,
}: BrainExplorerProps) {
  const qualityState = useBrainQuality(quality);
  const reducedMotion = usePrefersReducedMotion();
  const highContrast = useHighContrast();
  const textSize = useTextSize();
  const descriptionId = useId();
  const { ref, webgl, active, lost, markLost, retry } = useBrainStage<HTMLDivElement>();

  // Esc exits isolation first; otherwise clears the active region selection.
  useEffect(() => {
    if (!selectedRegion && !isolated) return;
    const onKeyDown = (e: KeyboardEvent) => {
      if (e.key !== "Escape") return;
      if (isolated && onExitIsolation) {
        onExitIsolation();
      } else {
        onSelectRegion(null);
      }
    };
    window.addEventListener("keydown", onKeyDown);
    return () => window.removeEventListener("keydown", onKeyDown);
  }, [selectedRegion, isolated, onExitIsolation, onSelectRegion]);

  const selectedInfo = selectedRegion
    ? BRAIN_REGIONS.find((r) => r.id === selectedRegion) ?? null
    : null;

  const canvasDescription = useMemo(() => {
    const modeLabel =
      mode === "anatomy"
        ? "Anatomy view"
        : mode === "functional"
          ? "Functional networks view showing connection arcs"
          : mode === "activity"
            ? "Activity associations view"
            : compare
              ? `Compare view showing ${ACTIVITY_META[compare.activityA].label} and ${ACTIVITY_META[compare.activityB].label}`
              : "Compare view";

    const parts: string[] = [
      `3D particle brain atlas in ${modeLabel}.`,
    ];

    if (selectedInfo) {
      parts.push(
        isolated
          ? `Isolated region: ${selectedInfo.name}. Other regions are faded out; press Escape to exit isolation.`
          : `Selected region: ${selectedInfo.name}. ${selectedInfo.shortDescription}`,
      );
    } else {
      parts.push("No region selected. Tab into the region list or pick a region below the canvas.");
    }

    if (crossSection?.enabled) {
      parts.push(
        `Cross-section cut enabled along ${CUT_AXIS_DEFAULTS[crossSection.axis].label} at position ${crossSection.position.toFixed(2)}, keeping hippocampus and amygdala visible.`,
      );
    }

    if (mode === "activity") {
      const highlighted = BRAIN_REGIONS.filter((r) => (activity[r.id] ?? 0) > 0)
        .map((r) => `${r.name} ${Math.round((activity[r.id] ?? 0) * 100)}%`)
        .join(", ");
      parts.push(
        highlighted
          ? `Active educational region associations: ${highlighted}.`
          : "No logged activity intensities yet.",
      );
    }

    if (srContextNote) {
      parts.push(srContextNote);
    }

    return parts.join(" ");
  }, [activity, compare, crossSection, isolated, mode, selectedInfo, srContextNote]);

  const liveAnnouncement = selectedInfo
    ? isolated
      ? `${selectedInfo.name} isolated. Press Escape to exit isolation.`
      : `${selectedInfo.name} selected. ${selectedInfo.shortDescription}`
    : mode === "compare" && compare
      ? `Comparing ${ACTIVITY_META[compare.activityA].label} and ${ACTIVITY_META[compare.activityB].label}.`
      : "No brain region selected.";

  return (
    <div
      ref={ref}
      role="region"
      tabIndex={-1}
      aria-label="Interactive 3D brain atlas"
      aria-describedby={descriptionId}
      data-brain-canvas-focus="true"
      data-quality={qualityState.tier}
      data-high-contrast={highContrast ? "true" : "false"}
      data-text-size={textSize}
      className={cn(
        "relative h-[460px] w-full overflow-hidden rounded-xl border bg-[#060913] outline-none sm:h-[520px]",
        highContrast ? "border-border-strong" : "border-white/[0.08]",
        className,
      )}
    >
      <p id={descriptionId} className="sr-only">
        {canvasDescription}
      </p>

      {/* Keyboard-accessible region selector: stays offscreen until focused so focus rings are always visible. */}
      <nav
        aria-label="Brain regions"
        className="sr-only focus-within:not-sr-only focus-within:absolute focus-within:inset-x-3 focus-within:top-3 focus-within:z-20 focus-within:rounded-control focus-within:border focus-within:border-border-strong focus-within:bg-surface/95 focus-within:p-2 focus-within:backdrop-blur-md"
      >
        <ul className="flex flex-wrap gap-1.5">
          {BRAIN_REGIONS.map((region) => {
            const isSelected = selectedRegion === region.id;
            return (
              <li key={region.id}>
                <button
                  type="button"
                  aria-pressed={isSelected}
                  onClick={() => onSelectRegion(isSelected ? null : region.id)}
                  onFocus={() => onHoverRegion?.(region.id)}
                  onBlur={() => onHoverRegion?.(null)}
                  className={cn(
                    "rounded-chip border px-2.5 py-1 text-caption font-medium transition-colors",
                    isSelected
                      ? "border-cyan bg-cyan/15 text-foreground"
                      : "border-border bg-surface-2 text-foreground hover:border-border-strong",
                  )}
                >
                  {region.name}
                </button>
              </li>
            );
          })}
        </ul>
      </nav>

      <div aria-live="polite" className="sr-only">
        {liveAnnouncement}
      </div>

      {webgl === false || lost ? (
        <BrainFallback lost={lost} onRetry={retry} description={canvasDescription} />
      ) : webgl === true ? (
        <BrainExplorerCanvas
          mode={mode}
          selectedRegion={selectedRegion}
          activity={activity}
          activityRef={activityRef}
          onSelectRegion={onSelectRegion}
          onHoverRegion={onHoverRegion}
          quality={qualityState}
          qualityPref={quality}
          reducedMotion={reducedMotion}
          highContrast={highContrast}
          active={active}
          onContextLost={markLost}
          isolated={isolated}
          compare={compare}
          crossSection={crossSection}
          focusRequestKey={focusRequestKey}
          onGlbStatusChange={onGlbStatusChange}
          brainSize={brainSize}
          cameraAction={cameraAction}
        />
      ) : (
        <div className="h-full w-full bg-[#060913]" />
      )}

      {mode === "activity" || mode === "compare" ? (
        <p
          className={cn(
            "pointer-events-none absolute inset-x-3 bottom-16 text-center text-caption md:bottom-3",
            highContrast ? "text-foreground" : "text-muted-foreground",
          )}
        >
          {ACTIVITY_DISCLAIMER}
        </p>
      ) : null}
    </div>
  );
}

export default BrainExplorer;
