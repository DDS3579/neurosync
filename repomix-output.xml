      (dow === 0 || dow === 6 ? weekend : weekday).push(eveningMin(s.bedtime));
    }
    expect(mean(weekend) ?? 0).toBeGreaterThan(mean(weekday) ?? 0);
  });

  it('varies learning methods across all six options', () => {
    expect(new Set(d90.focus.map((s) => s.method)).size).toBe(6);
  });
});
```

**Notes**

- Run: `pnpm vitest run src/lib/insights` — 27 new test cases across the three files; all domain imports are type-only, so no alias config is needed at test runtime.
- Only the assumed stats exports are used (`mean`, `stdDev`, `pearson`, `groupByDate`, `round1`, `clamp`); the bedtime circular SD is implemented locally in `weekly.ts` so it doesn't depend on unlisted exports.
- Design decisions documented in code: "flat" tolerances (15 min sleep, 30 min totals, 0.3 ratings, 1 glass water, 0 days); comparison keys omitted when either week lacks data; experiment direction stays `unknown` below 5 days/period; demo `rand()` call order is fixed and timestamps derive from the data's own dates, never the clock.
- Measured demo characteristics (seed 42): r ≈ 0.43–0.50, check-ins 91%, focus days 70%, movement 55%, nutrition 72%, habits 60%, weekend bedtime drift ≈ +40 min — test bands are set around these verified values.
</file>

