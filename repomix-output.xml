<file path="src/features/landing/FinalCtaFooter.tsx">
"use client";

import { useEffect, useRef } from "react";
import Link from "next/link";

import { usePrefersReducedMotion } from "@/features/brain/useBrainQuality";
import { useScrollProgress } from "./useScrollProgress";

interface DustParticle {
  angle: number;
  radius: number; // normalized 0.18..0.52 of min dimension
  size: number;
  alpha: number;
  cyan: boolean;
}

function createDustParticles(): DustParticle[] {
  const out: DustParticle[] = [];
  const total = 84;
  const golden = Math.PI * (3 - Math.sqrt(5));
  for (let i = 0; i < total; i++) {
    const t = (i + 0.5) / total;
    out.push({
      angle: i * golden,
      radius: 0.18 + Math.sqrt(t) * 0.36,
      size: 0.9 + (i % 3) * 0.45,
      alpha: 0.22 + (1 - t) * 0.5,
      cyan: i % 3 !== 0,
    });
  }
  return out;
}

const DUST = createDustParticles();

/**
 * Section 7: Final CTA with scroll-converging dust canvas + minimal footer.
 */
export function FinalCtaFooter() {
  const sectionRef = useRef<HTMLElement>(null);
  const canvasRef = useRef<HTMLCanvasElement>(null);
  const reducedMotion = usePrefersReducedMotion();

  const progress = useScrollProgress(sectionRef, {
    start: "top bottom",
    end: "center center",
    disabled: reducedMotion,
    refreshKey: `final-cta-${reducedMotion}`,
  });

  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const draw = () => {
      const parent = canvas.parentElement;
      if (!parent) return;
      const rect = parent.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = Math.max(1, Math.floor(rect.width));
      const h = Math.max(1, Math.floor(rect.height));

      if (canvas.width !== Math.floor(w * dpr) || canvas.height !== Math.floor(h * dpr)) {
        canvas.width = Math.floor(w * dpr);
        canvas.height = Math.floor(h * dpr);
        canvas.style.width = `${w}px`;
        canvas.style.height = `${h}px`;
      }

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);

      const cx = w * 0.5;
      const cy = h * 0.54;
      const spread = Math.min(w, h);
      const converge = reducedMotion ? 0.35 : progress;

      for (let i = 0; i < DUST.length; i++) {
        const p = DUST[i];
        const r = p.radius * spread * (1 - converge * 0.62);
        const theta = p.angle + converge * 0.45;
        const x = cx + Math.cos(theta) * r;
        const y = cy + Math.sin(theta) * r * 0.72;

        ctx.fillStyle = p.cyan
          ? `rgba(34, 211, 238, ${p.alpha})`
          : `rgba(139, 92, 246, ${p.alpha})`;
        ctx.beginPath();
        ctx.arc(x, y, p.size, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    draw();
    window.addEventListener("resize", draw, { passive: true });
    return () => window.removeEventListener("resize", draw);
  }, [progress, reducedMotion]);

  return (
    <section
      id="ready"
      ref={sectionRef}
      aria-labelledby="final-cta-heading"
      className="relative z-10 border-t border-white/[0.08] bg-[#060913]"
    >
      {/* Converging dust CTA stage */}
      <div className="relative flex min-h-[70svh] w-full flex-col items-center justify-center overflow-hidden px-5 py-24 text-center sm:px-10">
        <canvas
          ref={canvasRef}
          aria-hidden="true"
          className="pointer-events-none absolute inset-0 h-full w-full"
        />

        <div className="relative z-10 flex max-w-3xl flex-col items-center gap-8">
          <p className="font-mono text-[11px] uppercase tracking-[0.18em] text-[#22D3EE]">
            OBSERVATORY / 06
          </p>
          <h2
            id="final-cta-heading"
            className="font-heading text-[clamp(2.25rem,6vw,5rem)] leading-[0.98] font-medium tracking-[-0.04em] text-[#E6EAF5]"
          >
            Ready to look inward?
          </h2>
          <Link
            href="/overview"
            className="inline-flex h-12 items-center gap-2.5 rounded-[10px] border border-[#8B5CF6]/70 bg-[#7C3AED] px-6 text-sm font-medium text-white transition-colors hover:bg-[#8B5CF6]"
          >
            Enter the observatory
            <span aria-hidden="true">→</span>
          </Link>
        </div>
      </div>
    </section>
  );
}

export { LandingFooter } from "./LandingFooter";
</file>

<file path="src/features/landing/SmoothScroll.tsx">
"use client";

import {
  createContext,
  useCallback,
  useContext,
  useEffect,
  useRef,
  useState,
  type ReactNode,
} from "react";
import type Lenis from "lenis";

import { usePrefersReducedMotion } from "@/features/brain/useBrainQuality";
import { isScrollKey, loadScrollEngine } from "./scrollEngine";

interface SmoothScrollContextValue {
  scrollTo: (target: string | number | HTMLElement, offset?: number) => void;
  scrollReady: boolean;
  ensureScrollEngine: () => void;
  setScrollLocked: (locked: boolean) => void;
}

const SmoothScrollContext = createContext<SmoothScrollContextValue>({
  scrollTo: () => {},
  scrollReady: false,
  ensureScrollEngine: () => {},
  setScrollLocked: () => {},
});

export function useSmoothScroll() {
  return useContext(SmoothScrollContext);
}

/**
 * Defers loading Lenis + GSAP ScrollTrigger until the user scrolls, jumps to a hash,
 * or triggers smooth navigation — keeping the initial hero bundle light.
 * Disabled automatically when `prefers-reduced-motion: reduce` is active.
 */
export function SmoothScroll({ children }: { children: ReactNode }) {
  const reducedMotion = usePrefersReducedMotion();
  const lenisRef = useRef<Lenis | null>(null);
  const lockedRef = useRef(false);
  const [activated, setActivated] = useState(false);
  const [scrollReady, setScrollReady] = useState(false);

  const setScrollLocked = useCallback((locked: boolean) => {
    lockedRef.current = locked;
    const lenis = lenisRef.current;
    if (lenis) {
      if (locked) lenis.stop();
      else lenis.start();
    }
  }, []);

  const ensureScrollEngine = useCallback(() => {
    if (!reducedMotion) {
      setActivated(true);
    }
  }, [reducedMotion]);

  useEffect(() => {
    if (reducedMotion || activated) return;
    if (typeof window === "undefined") return;

    if (window.scrollY > 4 || Boolean(window.location.hash)) {
      const id = window.requestAnimationFrame(() => setActivated(true));
      return () => window.cancelAnimationFrame(id);
    }

    const triggerActivation = () => {
      if (lockedRef.current) return;
      setActivated(true);
    };
    const onKeyDown = (event: KeyboardEvent) => {
      if (lockedRef.current) return;
      if (isScrollKey(event.key)) {
        setActivated(true);
      }
    };

    window.addEventListener("wheel", triggerActivation, { passive: true, once: true });
    window.addEventListener("touchmove", triggerActivation, { passive: true, once: true });
    window.addEventListener("scroll", triggerActivation, { passive: true, once: true });
    window.addEventListener("hashchange", triggerActivation, { passive: true, once: true });
    window.addEventListener("keydown", onKeyDown, { passive: true });

    return () => {
      window.removeEventListener("wheel", triggerActivation);
      window.removeEventListener("touchmove", triggerActivation);
      window.removeEventListener("scroll", triggerActivation);
      window.removeEventListener("hashchange", triggerActivation);
      window.removeEventListener("keydown", onKeyDown);
    };
  }, [reducedMotion, activated]);

  useEffect(() => {
    if (reducedMotion) {
      lenisRef.current?.destroy();
      lenisRef.current = null;
      return;
    }

    if (!activated) return;

    let cancelled = false;
    let cleanup: (() => void) | undefined;

    void loadScrollEngine().then(({ gsap, ScrollTrigger, Lenis: LenisCtor }) => {
      if (cancelled) return;

      const lenis = new LenisCtor({
        duration: 1.15,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
      });
      if (lockedRef.current) {
        lenis.stop();
      }
      lenisRef.current = lenis;

      const handleScroll = () => {
        ScrollTrigger.update();
      };
      lenis.on("scroll", handleScroll);

      const tick = (time: number) => {
        lenis.raf(time * 1000);
      };
      gsap.ticker.add(tick);
      gsap.ticker.lagSmoothing(0);

      setScrollReady(true);

      cleanup = () => {
        gsap.ticker.remove(tick);
        lenis.off("scroll", handleScroll);
        lenis.destroy();
        lenisRef.current = null;
      };
    });

    return () => {
      cancelled = true;
      setScrollReady(false);
      cleanup?.();
    };
  }, [reducedMotion, activated]);

  const scrollTo = useCallback(
    (target: string | number | HTMLElement, offset = 0) => {
      const nativeScroll = () => {
        if (typeof target === "number") {
          window.scrollTo({
            top: target + offset,
            behavior: reducedMotion ? "auto" : "smooth",
          });
          return;
        }

        const el =
          typeof target === "string"
            ? document.querySelector<HTMLElement>(target)
            : target;
        if (!el) return;

        const top = el.getBoundingClientRect().top + window.scrollY + offset;
        window.scrollTo({
          top,
          behavior: reducedMotion ? "auto" : "smooth",
        });
      };

      if (reducedMotion) {
        nativeScroll();
        return;
      }

      setActivated(true);
      const lenis = lenisRef.current;
      if (lenis) {
        lenis.scrollTo(target, { offset });
        return;
      }

      // Start scrolling immediately if Lenis is still loading, and ensure engine mounts.
      nativeScroll();
      void loadScrollEngine().then(() => {
        if (lenisRef.current) {
          lenisRef.current.scrollTo(target, { offset });
        }
      });
    },
    [reducedMotion],
  );

  return (
    <SmoothScrollContext.Provider
      value={{
        scrollTo,
        scrollReady: !reducedMotion && scrollReady,
        ensureScrollEngine,
        setScrollLocked,
      }}
    >
      {children}
    </SmoothScrollContext.Provider>
  );
}
</file>

<file path="src/features/landing/useScrollProgress.ts">
"use client";

import { useEffect, useRef, useState, type RefObject } from "react";

import { useSmoothScroll } from "./SmoothScroll";
import { loadGsapScrollTrigger } from "./scrollEngine";

const PROGRESS_EPSILON = 0.003;

export interface UseScrollProgressOptions {
  start?: string | number | (() => string | number);
  end?: string | number | (() => string | number);
  disabled?: boolean;
  /** Changing this key forces the ScrollTrigger to recreate cleanly (e.g. responsive end). */
  refreshKey?: string | number | boolean;
}

/**
 * Tracks a ScrollTrigger's 0..1 progress in a ref and flushes into React state
 * via requestAnimationFrame only when it has changed by more than 0.003.
 * Defers loading GSAP ScrollTrigger until SmoothScroll activates.
 */
export function useScrollProgress(
  trigger: RefObject<HTMLElement | null>,
  {
    start = "top top",
    end = "bottom bottom",
    disabled = false,
    refreshKey,
  }: UseScrollProgressOptions = {},
): number {
  const { scrollReady } = useSmoothScroll();
  const [progress, setProgress] = useState(0);
  const latestRef = useRef(0);
  const committedRef = useRef(0);
  const rafRef = useRef<number | null>(null);

  useEffect(() => {
    const cancelPending = () => {
      if (rafRef.current !== null) {
        cancelAnimationFrame(rafRef.current);
        rafRef.current = null;
      }
    };

    if (disabled) {
      cancelPending();
      latestRef.current = 0;
      if (committedRef.current !== 0) {
        committedRef.current = 0;
        rafRef.current = requestAnimationFrame(() => {
          rafRef.current = null;
          setProgress(0);
        });
      }
      return cancelPending;
    }

    if (!scrollReady) return cancelPending;

    const el = trigger.current;
    if (!el) return;

    let cancelled = false;
    let killTrigger: (() => void) | undefined;

    const flush = () => {
      rafRef.current = null;
      const next = latestRef.current;
      const atBoundary =
        (next === 0 && committedRef.current !== 0) ||
        (next === 1 && committedRef.current !== 1);
      if (Math.abs(next - committedRef.current) > PROGRESS_EPSILON || atBoundary) {
        committedRef.current = next;
        setProgress(next);
      }
    };

    const scheduleFlush = () => {
      if (rafRef.current === null) {
        rafRef.current = requestAnimationFrame(flush);
      }
    };

    void loadGsapScrollTrigger().then(({ ScrollTrigger }) => {
      if (cancelled) return;

      const st = ScrollTrigger.create({
        trigger: el,
        start,
        end,
        invalidateOnRefresh: true,
        onUpdate: (self) => {
          latestRef.current = self.progress;
          scheduleFlush();
        },
        onRefresh: (self) => {
          latestRef.current = self.progress;
          scheduleFlush();
        },
      });

      ScrollTrigger.refresh();
      latestRef.current = st.progress;
      scheduleFlush();
      killTrigger = () => st.kill();
    });

    return () => {
      cancelled = true;
      cancelPending();
      killTrigger?.();
    };
    // `start`/`end` may be inline functions or primitives; `refreshKey` controls intentional rebinds.
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [trigger, disabled, refreshKey, scrollReady]);

  return progress;
}
</file>

