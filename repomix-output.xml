<file path="src/features/habits/components/HabitsTab.tsx">
"use client";

import { useMemo, useState } from "react";
import { zodResolver } from "@hookform/resolvers/zod";
import { Archive, ArchiveRestore, Check, Pencil, Plus, Trash2 } from "lucide-react";
import { useForm } from "react-hook-form";
import { toast } from "sonner";

import { EmptyState } from "@/components/nx";
import { Button } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { habitFormSchema, type HabitFormValues } from "@/features/habits/habitUtils";
import { toLocalISODate } from "@/features/sleep/sleepUtils";
import { cn } from "@/lib/utils";
import type { Habit, HabitLog, ISODate } from "@/types/domain";

export interface HabitsTabProps {
  habits: Habit[];
  habitLogs: HabitLog[];
  onToggleHabit: (habitId: string, date: ISODate, nextDone: boolean) => Promise<void>;
  onAddHabit: (name: string) => Promise<void>;
  onRenameHabit: (id: string, name: string) => Promise<void>;
  onArchiveHabit: (id: string, archived: boolean) => Promise<void>;
  onDeleteHabit: (id: string) => Promise<void>;
}

export function HabitsTab({
  habits,
  habitLogs,
  onToggleHabit,
  onAddHabit,
  onRenameHabit,
  onArchiveHabit,
  onDeleteHabit,
}: HabitsTabProps) {
  const [selectedDate, setSelectedDate] = useState<ISODate>(() => toLocalISODate());
  const [editingHabitId, setEditingHabitId] = useState<string | null>(null);

  const form = useForm<HabitFormValues>({
    resolver: zodResolver(habitFormSchema),
    defaultValues: { name: "" },
  });

  const activeHabits = useMemo(
    () => habits.filter((h) => !h.archived),
    [habits],
  );
  const archivedHabits = useMemo(
    () => habits.filter((h) => h.archived),
    [habits],
  );

  const doneByHabitId = useMemo(() => {
    const map = new Map<string, boolean>();
    for (const log of habitLogs) {
      if (log.date === selectedDate && log.done) {
        map.set(log.habitId, true);
      }
    }
    return map;
  }, [habitLogs, selectedDate]);

  const recentLogs = useMemo(() => {
    const habitName = new Map(habits.map((h) => [h.id, h.name]));
    return [...habitLogs]
      .filter((l) => l.done)
      .sort((a, b) => b.date.localeCompare(a.date))
      .slice(0, 14)
      .map((l) => ({ ...l, habitName: habitName.get(l.habitId) ?? "Habit" }));
  }, [habitLogs, habits]);

  const onSubmit = form.handleSubmit(async (values) => {
    const parsed = habitFormSchema.parse(values);
    if (editingHabitId) {
      await onRenameHabit(editingHabitId, parsed.name);
      toast.success(`Updated "${parsed.name}".`);
      setEditingHabitId(null);
    } else {
      await onAddHabit(parsed.name);
      toast.success(`Added "${parsed.name}".`);
    }
    form.reset({ name: "" });
  });

  return (
    <div className="grid gap-6 lg:grid-cols-12">
      <div className="space-y-6 lg:col-span-7">
        <Card className="rounded-card border border-border bg-surface p-5 shadow-none">
          <div className="flex flex-wrap items-end justify-between gap-4 border-b border-border pb-4">
            <div className="space-y-1.5">
              <Label htmlFor="habits-date">Day to log</Label>
              <Input
                id="habits-date"
                type="date"
                value={selectedDate}
                onChange={(e) => setSelectedDate(e.target.value)}
                className="w-44 rounded-control border-border bg-surface-2 font-mono text-body"
              />
            </div>
            <span className="text-caption text-muted-foreground">
              Tap to toggle · no streaks or penalties
            </span>
          </div>

          {activeHabits.length === 0 ? (
            <div className="pt-4">
              <EmptyState
                title="No active habits"
                description="Add a habit below or restore an archived one."
              />
            </div>
          ) : (
            <ul className="mt-4 space-y-2">
              {activeHabits.map((habit) => {
                const done = doneByHabitId.get(habit.id) ?? false;
                return (
                  <li
                    key={habit.id}
                    className="flex items-center justify-between gap-3 rounded-control border border-border bg-surface-2 px-3 py-2.5"
                  >
                    <button
                      type="button"
                      aria-pressed={done}
                      onClick={async () => {
                        await onToggleHabit(habit.id, selectedDate, !done);
                        toast.success(
                          !done
                            ? `Marked "${habit.name}" for ${selectedDate}.`
                            : `Unmarked "${habit.name}" for ${selectedDate}.`,
                        );
                      }}
                      className="flex flex-1 items-center gap-3 text-left"
                    >
                      <span
                        className={cn(
                          "flex size-6 shrink-0 items-center justify-center rounded-md border transition-colors",
                          done
                            ? "border-cyan bg-cyan/20 text-cyan"
                            : "border-border bg-surface text-transparent",
                        )}
                      >
                        <Check className="size-3.5" aria-hidden />
                      </span>
                      <span className="text-body font-medium text-foreground">
                        {habit.icon ? `${habit.icon} ` : ""}
                        {habit.name}
                      </span>
                    </button>

                    <div className="flex items-center gap-1">
                      <Button
                        type="button"
                        size="icon-sm"
                        variant="ghost"
                        aria-label={`Edit habit ${habit.name}`}
                        onClick={() => {
                          setEditingHabitId(habit.id);
                          form.reset({ name: habit.name });
                        }}
                      >
                        <Pencil className="size-3.5" aria-hidden />
                      </Button>
                      <Button
                        type="button"
                        size="icon-sm"
                        variant="ghost"
                        aria-label={`Archive habit ${habit.name}`}
                        onClick={async () => {
                          await onArchiveHabit(habit.id, true);
                          toast.success(`Archived "${habit.name}".`);
                        }}
                      >
                        <Archive className="size-3.5 text-muted-foreground" aria-hidden />
                      </Button>
                    </div>
                  </li>
                );
              })}
            </ul>
          )}
        </Card>

        <Card className="rounded-card border border-border bg-surface p-5 shadow-none">
          <form onSubmit={onSubmit} className="space-y-3" noValidate>
            <Label htmlFor="habit-name">
              {editingHabitId ? "Rename habit" : "Add a habit"}
            </Label>
            <div className="flex flex-col gap-2 sm:flex-row">
              <Input
                id="habit-name"
                placeholder="e.g. Morning sunlight"
                {...form.register("name")}
                className="flex-1 rounded-control border-border bg-surface-2"
              />
              <div className="flex gap-2">
                {editingHabitId ? (
                  <Button
                    type="button"
                    variant="outline"
                    onClick={() => {
                      setEditingHabitId(null);
                      form.reset({ name: "" });
                    }}
                    className="rounded-control"
                  >
                    Cancel
                  </Button>
                ) : null}
                <Button
                  type="submit"
                  disabled={form.formState.isSubmitting}
                  className="gap-1.5 rounded-control bg-violet text-white hover:bg-violet/90"
                >
                  <Plus className="size-4" aria-hidden />
                  {editingHabitId ? "Save name" : "Add habit"}
                </Button>
              </div>
            </div>
            {form.formState.errors.name ? (
              <p role="alert" className="text-caption text-danger">
                {form.formState.errors.name.message}
              </p>
            ) : null}
          </form>
        </Card>
      </div>

      <div className="space-y-6 lg:col-span-5">
        {archivedHabits.length > 0 ? (
          <div className="space-y-3">
            <h2 className="text-section font-medium text-foreground">Archived habits</h2>
            <ul className="space-y-2">
              {archivedHabits.map((habit) => (
                <li
                  key={habit.id}
                  className="flex items-center justify-between gap-2 rounded-card border border-border bg-surface p-3"
                >
                  <span className="text-body text-muted-foreground">{habit.name}</span>
                  <div className="flex items-center gap-1">
                    <Button
                      type="button"
                      size="icon-sm"
                      variant="ghost"
                      aria-label={`Restore habit ${habit.name}`}
                      onClick={async () => {
                        await onArchiveHabit(habit.id, false);
                        toast.success(`Restored "${habit.name}".`);
                      }}
                    >
                      <ArchiveRestore className="size-3.5" aria-hidden />
                    </Button>
                    <Button
                      type="button"
                      size="icon-sm"
                      variant="ghost"
                      aria-label={`Delete habit ${habit.name}`}
                      onClick={async () => {
                        await onDeleteHabit(habit.id);
                        toast.success(`Deleted "${habit.name}".`);
                      }}
                    >
                      <Trash2 className="size-3.5 text-muted-foreground" aria-hidden />
                    </Button>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ) : null}

        <div className="space-y-3">
          <h2 className="text-section font-medium text-foreground">Recent completions</h2>
          {recentLogs.length === 0 ? (
            <EmptyState
              title="Nothing toggled yet"
              description="Checked habits appear here for quick review."
            />
          ) : (
            <ul className="space-y-2">
              {recentLogs.map((log) => (
                <li
                  key={log.id}
                  className="flex items-center justify-between gap-2 rounded-card border border-border bg-surface px-4 py-3"
                >
                  <div>
                    <p className="text-body text-foreground">{log.habitName}</p>
                    <p className="font-mono text-caption text-cyan tabular-nums">{log.date}</p>
                  </div>
                  <Button
                    type="button"
                    size="icon-sm"
                    variant="ghost"
                    aria-label={`Remove completion of ${log.habitName} on ${log.date}`}
                    onClick={async () => {
                      await onToggleHabit(log.habitId, log.date, false);
                      toast.success(`Removed "${log.habitName}" for ${log.date}.`);
                    }}
                  >
                    <Trash2 className="size-3.5 text-muted-foreground" aria-hidden />
                  </Button>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/features/habits/components/HabitsWorkspace.tsx">
"use client";

import { useCallback, useSyncExternalStore } from "react";

import { PageHeader } from "@/components/nx";
import { Skeleton } from "@/components/ui/skeleton";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import {
  HABIT_HASH_EVENT,
  parseHabitTabHash,
  type HabitTab,
} from "@/features/habits/habitUtils";
import type {
  ActivityLog,
  DailyCheckin,
  GratitudeEntry,
  Habit,
  HabitLog,
  ISODate,
  JournalEntry,
  MindfulnessSession,
  MovementLog,
  NutritionLog,
  SleepLog,
} from "@/types/domain";

import { ActivitiesTab } from "@/features/activities/components/ActivitiesTab";
import { CheckinTab } from "./CheckinTab";
import { HabitsTab } from "./HabitsTab";
import { MovementTab } from "./MovementTab";
import { NutritionTab } from "./NutritionTab";
import { SleepTab } from "./SleepTab";
import { MindTab } from "@/features/mind/components/MindTab";

export interface HabitsWorkspaceProps {
  sleepTargetMin: number;
  checkins: DailyCheckin[];
  sleepLogs: SleepLog[];
  movementLogs: MovementLog[];
  nutritionLogs: NutritionLog[];
  habits: Habit[];
  habitLogs: HabitLog[];
  onSaveCheckin: (
    values: Omit<DailyCheckin, "id" | "createdAt" | "updatedAt">,
  ) => Promise<"created" | "updated">;
  onDeleteCheckin: (id: string) => Promise<void>;
  onCreateSleep: (values: Omit<SleepLog, "id" | "createdAt" | "updatedAt">) => Promise<void>;
  onUpdateSleep: (
    id: string,
    values: Omit<SleepLog, "id" | "createdAt" | "updatedAt">,
  ) => Promise<void>;
  onDeleteSleep: (id: string) => Promise<void>;
  onCreateMovement: (
    values: Omit<MovementLog, "id" | "createdAt" | "updatedAt">,
  ) => Promise<void>;
  onUpdateMovement: (
    id: string,
    values: Omit<MovementLog, "id" | "createdAt" | "updatedAt">,
  ) => Promise<void>;
  onDeleteMovement: (id: string) => Promise<void>;
  onCreateNutrition: (
    values: Omit<NutritionLog, "id" | "createdAt" | "updatedAt">,
  ) => Promise<void>;
  onUpdateNutrition: (
    id: string,
    values: Omit<NutritionLog, "id" | "createdAt" | "updatedAt">,
  ) => Promise<void>;
  onDeleteNutrition: (id: string) => Promise<void>;
  onToggleHabit: (habitId: string, date: ISODate, nextDone: boolean) => Promise<void>;
  onAddHabit: (name: string) => Promise<void>;
  onRenameHabit: (id: string, name: string) => Promise<void>;
  onArchiveHabit: (id: string, archived: boolean) => Promise<void>;
  onDeleteHabit: (id: string) => Promise<void>;
  mindfulnessSessions: MindfulnessSession[];
  journalEntries: JournalEntry[];
  gratitudeEntries: GratitudeEntry[];
  onCreateMindfulness: (
    values: Omit<MindfulnessSession, "id" | "createdAt" | "updatedAt">,
  ) => Promise<void>;
  onDeleteMindfulness: (id: string) => Promise<void>;
  onCreateJournal: (
    values: Omit<JournalEntry, "id" | "createdAt" | "updatedAt">,
  ) => Promise<void>;
  onUpdateJournal: (
    id: string,
    values: Omit<JournalEntry, "id" | "createdAt" | "updatedAt">,
  ) => Promise<void>;
  onDeleteJournal: (id: string) => Promise<void>;
  onSaveGratitude: (
    values: Omit<GratitudeEntry, "id" | "createdAt" | "updatedAt">,
  ) => Promise<"created" | "updated">;
  onDeleteGratitude: (id: string) => Promise<void>;
  activityLogs: ActivityLog[];
  onCreateActivity: (
    values: Omit<ActivityLog, "id" | "createdAt" | "updatedAt">,
  ) => Promise<void>;
  onUpdateActivity: (
    id: string,
    values: Omit<ActivityLog, "id" | "createdAt" | "updatedAt">,
  ) => Promise<void>;
  onDeleteActivity: (id: string) => Promise<void>;
}

function subscribeHabitHash(callback: () => void): () => void {
  window.addEventListener("hashchange", callback);
  window.addEventListener("popstate", callback);
  window.addEventListener(HABIT_HASH_EVENT, callback);
  return () => {
    window.removeEventListener("hashchange", callback);
    window.removeEventListener("popstate", callback);
    window.removeEventListener(HABIT_HASH_EVENT, callback);
  };
}

function getHabitHashSnapshot(): HabitTab {
  return parseHabitTabHash(window.location.hash);
}

export function HabitsWorkspace(props: HabitsWorkspaceProps) {
  const activeTab = useSyncExternalStore(
    subscribeHabitHash,
    getHabitHashSnapshot,
    () => "checkin",
  );

  const handleTabChange = useCallback((next: string) => {
    const tab = parseHabitTabHash(next);
    if (typeof window !== "undefined") {
      const nextUrl = `${window.location.pathname}${window.location.search}#${tab}`;
      window.history.replaceState(null, "", nextUrl);
      window.dispatchEvent(new Event(HABIT_HASH_EVENT));
    }
  }, []);

  return (
    <div className="space-y-6">
      <PageHeader
        title="Daily Habits"
        description="Log today's check-in, sleep, movement, nutrition, habits, and mind notes locally with zero streak pressure."
      />

      <Tabs value={activeTab} onValueChange={handleTabChange} className="space-y-4">
        <TabsList className="h-auto w-full flex-wrap justify-start gap-1 rounded-control border border-border bg-surface p-1 sm:w-fit">
          <TabsTrigger value="checkin">Check-in</TabsTrigger>
          <TabsTrigger value="sleep">Sleep</TabsTrigger>
          <TabsTrigger value="movement">Movement</TabsTrigger>
          <TabsTrigger value="nutrition">Nutrition</TabsTrigger>
          <TabsTrigger value="habits">Habits</TabsTrigger>
          <TabsTrigger value="mind">Mind</TabsTrigger>
          <TabsTrigger value="activities">Activities</TabsTrigger>
        </TabsList>

        <TabsContent value="checkin">
          <CheckinTab
            checkins={props.checkins}
            onSaveCheckin={props.onSaveCheckin}
            onDeleteCheckin={props.onDeleteCheckin}
          />
        </TabsContent>

        <TabsContent value="sleep">
          <SleepTab
            sleepLogs={props.sleepLogs}
            sleepTargetMin={props.sleepTargetMin}
            onCreateSleep={props.onCreateSleep}
            onUpdateSleep={props.onUpdateSleep}
            onDeleteSleep={props.onDeleteSleep}
          />
        </TabsContent>

        <TabsContent value="movement">
          <MovementTab
            movementLogs={props.movementLogs}
            onCreateMovement={props.onCreateMovement}
            onUpdateMovement={props.onUpdateMovement}
            onDeleteMovement={props.onDeleteMovement}
          />
        </TabsContent>

        <TabsContent value="nutrition">
          <NutritionTab
            nutritionLogs={props.nutritionLogs}
            onCreateNutrition={props.onCreateNutrition}
            onUpdateNutrition={props.onUpdateNutrition}
            onDeleteNutrition={props.onDeleteNutrition}
          />
        </TabsContent>

        <TabsContent value="habits">
          <HabitsTab
            habits={props.habits}
            habitLogs={props.habitLogs}
            onToggleHabit={props.onToggleHabit}
            onAddHabit={props.onAddHabit}
            onRenameHabit={props.onRenameHabit}
            onArchiveHabit={props.onArchiveHabit}
            onDeleteHabit={props.onDeleteHabit}
          />
        </TabsContent>

        <TabsContent value="mind">
          <MindTab
            mindfulnessSessions={props.mindfulnessSessions}
            journalEntries={props.journalEntries}
            gratitudeEntries={props.gratitudeEntries}
            onCreateMindfulness={props.onCreateMindfulness}
            onDeleteMindfulness={props.onDeleteMindfulness}
            onCreateJournal={props.onCreateJournal}
            onUpdateJournal={props.onUpdateJournal}
            onDeleteJournal={props.onDeleteJournal}
            onSaveGratitude={props.onSaveGratitude}
            onDeleteGratitude={props.onDeleteGratitude}
          />
        </TabsContent>

        <TabsContent value="activities">
          <ActivitiesTab
            activityLogs={props.activityLogs}
            onCreateActivity={props.onCreateActivity}
            onUpdateActivity={props.onUpdateActivity}
            onDeleteActivity={props.onDeleteActivity}
          />
        </TabsContent>
      </Tabs>
    </div>
  );
}

export function HabitsSkeleton() {
  return (
    <div className="space-y-6" aria-hidden>
      <div className="space-y-2">
        <Skeleton className="h-8 w-44 rounded-[6px]" />
        <Skeleton className="h-4 w-96 max-w-full rounded-[4px]" />
      </div>
      <Skeleton className="h-10 w-80 max-w-full rounded-control" />
      <div className="grid gap-6 lg:grid-cols-12">
        <Skeleton className="h-[460px] rounded-card lg:col-span-7" />
        <Skeleton className="h-[340px] rounded-card lg:col-span-5" />
      </div>
    </div>
  );
}
